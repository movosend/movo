# Copiar a `.env.local` (gitignored) para desarrollo local.
#
# `EXPO_PUBLIC_*` queda embebida en el bundle en build time — no poner acá
# nada secreto. La URL del gateway varía por ambiente:
#   - Local: la IP LAN de tu máquina (o un túnel). `localhost` NO funciona
#     desde un dispositivo físico, solo desde el emulador/simulador.
#   - Dev:   https://api-dev.movosend.app
#   - Prod:  https://api.movosend.app (ver eas.json, perfil "production")
EXPO_PUBLIC_API_URL=http://localhost:3000

# MOVO-73: API keys de Google Maps para el paso de mapa del wizard de registro —
# `react-native-maps` (renderizado del mapa), distintas de `GOOGLE_MAPS_API_KEY` del
# backend (esa es la de Geocoding API, server-side, restringida por IP). Estas dos
# restringen por bundle id (iOS) / SHA fingerprint (Android) en la consola de Google
# Cloud, así que no son secretas de la misma forma — igual NO van a `app.json` (se
# trackea en git): `app.config.js` las lee de estas env vars en build/prebuild time
# (Expo CLI ya carga `.env.local` automáticamente, no hace falta el prefijo
# `EXPO_PUBLIC_` porque no necesitan viajar embebidas en el bundle JS). En builds de
# EAS **no** van al bloque `env` de `eas.json` (ese archivo también se trackea en
# git, mismo problema que `app.json`) — se cargan como EAS Environment Variables
# (`eas env:create`, o el dashboard de EAS), que sí quedan fuera del repo y se
# resuelven por perfil (development/preview/production) al buildear.
#
# Cómo generarlas (consola de Google Cloud — https://console.cloud.google.com):
#   1. Crear o reusar un proyecto de GCP para Movo (compartir el mismo proyecto que
#      usa el backend para GOOGLE_MAPS_API_KEY, sección "Geocoding" de
#      services/movo-svc-users/.env.example — mismo criterio que Twilio/Didit: un
#      proyecto/cuenta por integración externa, no una key por servicio).
#   2. Habilitar "Maps SDK for Android" y "Maps SDK for iOS" (APIs & Services > Library).
#   3. Credentials > Create Credentials > API key — crear DOS keys separadas (una para
#      cada plataforma, permite restricciones distintas):
#      - Android: restringir por "Android apps" con el SHA-1 del keystore de firma
#        (`eas credentials` una vez armado el build, o `keytool -list -v` sobre el
#        keystore local) + el package (`com.anonymous.movomobile`, ver app.config.js).
#      - iOS: restringir por "iOS apps" con el bundle id (`com.anonymous.movo-mobile`).
#   4. Pendiente, mismo estado que "eas init" (ver notas de MOVO-73 en CLAUDE.md): el
#      equipo todavía no generó estas keys. Sin ellas, el mapa del wizard no renderiza
#      tiles (falla silenciosa de `react-native-maps`, no rompe el resto de la app).
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=

# MOVO-107: el plugin `expo-notifications` agrega el entitlement `aps-environment`
# (Push Notifications) al proyecto iOS nativo. Un team personal de Apple (Apple ID
# gratis, el default de `expo run:ios` local) no puede firmar esa capability — el
# build entero falla con "Personal development teams ... do not support the Push
# Notifications capability". Dejar en `false` (o vacío) para development builds
# locales; poner `true` solo si tu Apple ID tiene una membership de pago del Apple
# Developer Program (o al buildear con EAS con un team de pago).
ENABLE_PUSH_NOTIFICATIONS=false
