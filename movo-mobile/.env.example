# Copiar a `.env.local` (gitignored) para desarrollo local.
#
# `EXPO_PUBLIC_*` queda embebida en el bundle en build time — no poner acá
# nada secreto. La URL del gateway varía por ambiente:
#   - Local: la IP LAN de tu máquina (o un túnel). `localhost` NO funciona
#     desde un dispositivo físico, solo desde el emulador/simulador.
#   - Dev:   https://api-dev.movosend.app
#   - Prod:  https://api.movosend.app (ver eas.json, perfil "production")
EXPO_PUBLIC_API_URL=http://localhost:3000
