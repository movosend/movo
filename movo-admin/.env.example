# Variables exclusivas del servidor. Nunca usar NEXT_PUBLIC_ para autenticación.
MOVO_GATEWAY_URL=https://api-dev.movosend.app
# Origen exacto del panel (para previews, usar su URL HTTPS exacta).
MOVO_APP_ORIGIN=https://admin.movosend.app
# Generar con: openssl rand -hex 32. Mantener estable entre instancias del entorno.
MOVO_SESSION_SECRET=
# Local: MOVO_APP_ORIGIN=https://localhost:3000 y npm run dev:https
# Si el gateway local usa otro puerto: MOVO_GATEWAY_URL=http://localhost:3000
# Solo desarrollo (se ignora en producción). Reemplaza la capa de datos de Usuarios por
# fixtures mientras MOVO-294 no esté desplegado; el login sigue yendo al gateway.
# MOVO_ADMIN_MOCK=1
# MOVO_ADMIN_MOCK_FAIL=kyc,ledger   # esas secciones fallan con 502 la primera vez (kyc! = siempre)
# MOVO_ADMIN_MOCK_LATENCY_MS=350
