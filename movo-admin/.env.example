# Variables exclusivas del servidor. Nunca usar NEXT_PUBLIC_ para autenticación.
MOVO_GATEWAY_URL=https://api-dev.movosend.app
# Origen exacto del panel (para previews, usar su URL HTTPS exacta).
MOVO_APP_ORIGIN=https://admin.movosend.app
# Generar con: openssl rand -hex 32. Mantener estable entre instancias del entorno.
MOVO_SESSION_SECRET=
# Local: MOVO_APP_ORIGIN=https://localhost:3000 y npm run dev:https
# Si el gateway local usa otro puerto: MOVO_GATEWAY_URL=http://localhost:3000
# Solo desarrollo (se ignora en producción). Reemplaza la capa de datos de Usuarios por
# fixtures mientras MOVO-294 no esté desplegado; el login sigue yendo al gateway.
# MOVO_ADMIN_MOCK=1
# MOVO_ADMIN_MOCK_FAIL=kyc,ledger   # esas secciones fallan con 502 la primera vez (kyc! = siempre)
#   actions! hace que las acciones de soporte (Acciones) respondan 502 y queden "Sin confirmar" en la bitácora
# MOVO_ADMIN_MOCK_LATENCY_MS=350
# Bandeja de soporte (MOVO-323), solo con MOVO_ADMIN_MOCK=1:
# MOVO_ADMIN_MOCK_FAIL=context,list   # claves: list counts thread context agents send write ws (la "!" final = siempre)
#   ws hace fallar el ticket del WebSocket: el panel cae a polling
# MOVO_ADMIN_MOCK_SIMULATE=0          # apaga la consulta que entra sola a los 16 s y las respuestas del usuario

# Mapa de seguimiento del envío (MOVO-328). Key de ArcGIS Location Platform restringida por referrer
# (es pública por diseño, va al navegador). Sin ella el mapa se dibuja sin teselas, solo ruta y marcadores.
# NEXT_PUBLIC_ESRI_API_KEY=
# Modo fixtures del seguimiento (con MOVO_ADMIN_MOCK=1): ids 00000000-0000-4000-8000-00000000000{1..8}
#   MOVO_ADMIN_MOCK_FAIL=tracking   # el seguimiento responde 502
