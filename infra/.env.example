# Env para infra/docker-compose.yml en local (ver docker-compose.local.yml).
# En dev/prod estas variables las genera el workflow de CI/CD leyendo
# AWS Secrets Manager (movo/<env>/app-secrets) — nunca se commitean.

POSTGRES_USER=movo
POSTGRES_PASSWORD=movo_local_pw
DATABASE_URL=postgresql://movo:movo_local_pw@postgres:5432/movo
JWT_SECRET=local_dev_jwt_secret
MERCADOPAGO_ACCESS_TOKEN=test_token
API_DOMAIN=localhost
IMAGE_TAG=local

# MOVO-71: default "console" (loguea el código en vez de mandar SMS real, ver ADR-012).
# Las credenciales de Twilio solo son obligatorias si SMS_PROVIDER=twilio. Auth vía API
# Key (recomendación de Twilio, no Auth Token) — TWILIO_ACCOUNT_SID sigue siendo
# obligatorio como identificador de cuenta, no como credencial.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=

# MOVO-71: solo para develop (SMS_PROVIDER=telegram) — manda el OTP a un grupo de
# Telegram en vez de un SMS real, para no depender de la consola de EC2 en dev. En
# prod se sigue usando twilio. Requeridas solo si SMS_PROVIDER=telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

