# ============================================================================
# Config del spike de Mercado Pago (MOVO-49 / MOVO-100)
# ============================================================================
# Copiar este archivo a ".env" (sin ".example") en esta misma carpeta y
# completar los valores. ".env" está en el .gitignore del repo raíz, así
# que nunca se sube a git — es seguro poner credenciales reales de test acá.
#
# DÓNDE SACAR CADA VALOR (paso a paso)
# -------------------------------------
# 1. Entrar a https://www.mercadopago.com.ar/developers/panel/app con tu
#    cuenta de MP normal (la de developer, no una de prueba).
# 2. Crear una aplicación nueva (o usar una existente) — tipo de integración
#    "Pagos online", modelo "Marketplace" (para que habilite application_fee
#    y el flujo OAuth).
# 3. Dentro de la app, ir a "Tus integraciones" > la app > sección
#    "Cuentas de prueba" y crear DOS cuentas:
#      - una de tipo "Vendedor" (va a ser el transportista de prueba)
#      - una de tipo "Comprador" (opcional, para probar Checkout Pro; para
#        este script no hace falta, tokenizamos la tarjeta directo)
#    Guardate el usuario/contraseña que te da MP para la cuenta Vendedor —
#    los vas a necesitar para loguearte en el paso de OAuth (opción 2 del
#    menú del script).
# 4. En la sección "Credenciales de prueba" de tu app vas a encontrar:
#      - Access Token de prueba   -> MP_APP_ACCESS_TOKEN
#      - Public Key de prueba     -> MP_APP_PUBLIC_KEY
#      - Client ID                -> MP_APP_CLIENT_ID
#      - Client secret            -> MP_APP_CLIENT_SECRET
# 5. En la sección de configuración de la app (URIs de redirección / OAuth)
#    agregar exactamente: http://localhost:8787/callback
#    (si usás otro puerto, cambiá también MP_REDIRECT_URI acá abajo para
#    que coincida).

# Access token de NUESTRA app de test (no el del transportista — ese se
# obtiene en tiempo de ejecución vía OAuth, no va en este archivo).
MP_APP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public Key de prueba de NUESTRA app (misma sección del panel que el Access
# Token). Necesaria para tokenizar la tarjeta cuando el pago se va a crear
# con el access_token de un vendedor conectado (split/marketplace) — un
# card_token creado con el Access Token PRIVADO solo es válido para pagos
# cobrados por esa misma cuenta, MP lo rechaza ("Card Token not found") si
# después se paga con el access_token de otra cuenta (el transportista).
MP_APP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Credenciales de la app, solo para el intercambio OAuth (AC2).
MP_APP_CLIENT_ID=1234567890123456
MP_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tiene que coincidir EXACTO con lo que registraste en el panel de la app.
MP_REDIRECT_URI=http://localhost:8787/callback

# Solo para la opción "2b" del menú (test de MOVO-111 AC3: ¿MP acepta un
# redirect_uri de esquema custom, tipo deep link de mobile, o exige https?).
# Registrá este mismo valor como Redirect URI ADICIONAL en el panel de la
# app (junto al de arriba) antes de correr esa opción — si no está
# registrado tal cual, MP lo rechaza igual sin que eso signifique nada
# sobre si "acepta esquemas custom" en general.
MP_DEEPLINK_TEST_REDIRECT_URI=movo://mp-oauth-callback

# Tarjeta de prueba a usar (por defecto, la Visa AR documentada por MP).
# Podés dejar estos valores tal cual salvo que quieras simular un rechazo
# (ver README.md para la lista completa de "nombres mágicos": APRO, OTHE,
# FUND, CONT, etc.)
MP_TEST_CARD_NUMBER=4509953566233704
MP_TEST_CARD_CVV=123
MP_TEST_CARD_EXP_MONTH=11
MP_TEST_CARD_EXP_YEAR=2030
MP_TEST_CARD_HOLDER_NAME=APRO
MP_TEST_PAYMENT_METHOD_ID=visa

# Email del "comprador" de prueba (no hace falta que exista de verdad).
MP_TEST_PAYER_EMAIL=comprador_test@testuser.com

# Montos de prueba para el hold (AC1) y la comisión de Movo (AC3, split).
# Son pesos argentinos ficticios en sandbox.
MP_HOLD_AMOUNT=1000
MP_APPLICATION_FEE=150
