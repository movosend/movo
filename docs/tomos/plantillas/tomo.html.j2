<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Movo · {{ tomo.numero_largo }} · {{ tomo.titulo }}</title>
<meta name="author" content="{% for i in p.integrantes %}{{ i.apellido|title }}, {{ i.nombre }}{% if not loop.last %}; {% endif %}{% endfor %}">
<meta name="description" content="{{ p.software }} · {{ p.subtitulo }} · {{ tomo.numero_largo }}: {{ tomo.titulo }}">
<meta name="keywords" content="Movo, logística P2P, Proyecto Final, UTN FRC, Ingeniería en Sistemas de Información">
<meta name="generator" content="docs/tomos/build.py (WeasyPrint)">
<link rel="stylesheet" href="estilos/print.css">
<style>
  @page {
    @bottom-left {
      content: "UTN FRC · Ingeniería en Sistemas de Información · Proyecto Final {{ p.anio }} · {{ p.curso }} · Grupo {{ p.grupo }}";
    }
  }
  /* Doble faz (las dos ediciones): margen interior junto al lomo (izquierda en impares, derecha en pares), número de página en el borde
     exterior y pie institucional en el interior. Los separadores y las secciones principales abren en página impar. */
  @page :right { margin: 25mm 20mm 22mm 30mm; }
  @page :left {
    margin: 25mm 30mm 22mm 20mm;
    @bottom-left {
      content: counter(page);
      font: 600 7.4pt/1 "JetBrains Mono";
      color: var(--ink-950);
      vertical-align: top;
      padding-top: 3mm;
    }
    @bottom-right {
      content: "UTN FRC · Ingeniería en Sistemas de Información · Proyecto Final {{ p.anio }} · {{ p.curso }} · Grupo {{ p.grupo }}";
      font: 400 6.6pt/1 "Inter";
      color: var(--ink-400);
      text-align: right;
      vertical-align: top;
      padding-top: 3.4mm;
    }
  }
{% include '_portadas.css.j2' %}
{% if edicion == 'digital' %}{% include '_tapa.css.j2' %}{% endif %}
  .ante, .pt, .sep, .presentacion, .indice, .ficha, .equipo-pg { break-before: right; }
  .verso-ante, .datos-edicion, .colofon { break-before: left; }
  body { string-set: tomo-corto "Movo · {{ tomo.numero_largo }} · {{ tomo.titulo }}"; }
</style>
</head>
<body class="ed-{{ edicion }}">

{% if edicion == 'digital' %}
{# ───────────── Tapa (edición digital) ───────────── #}
<section class="pagina-tapa">{% include '_tapa_frente.html.j2' %}</section>
{% endif %}

{# ───────────── Anteportada (falso título) ───────────── #}
<section class="ante">
  <div class="marca"><img src="assets/logos/movo-marca.svg" alt=""><span>movo</span></div>
  <div class="centro">
    <div class="barra-lima"></div>
    <div class="eyebrow-c">{{ tomo.numero_largo }}</div>
    <div class="titulo">{{ t1 }}{% if t2 %}<br>{{ t2 }}{% endif %}</div>
  </div>
  <div class="pie-ante eyebrow-c">Proyecto Final {{ p.anio }} · {{ p.curso }} · Grupo {{ p.grupo }}</div>
</section>

{# ───────────── Verso de la anteportada: la obra en tres tomos ───────────── #}
<section class="verso-ante">
  <div class="eyebrow-c" style="margin-top:0">Obra en {{ todos_tomos|length|replace('3','tres') }} tomos</div>
  <p style="margin:0 0 6mm"><b>{{ p.software }}: {{ p.subtitulo }}.</b><br>Proyecto Final {{ p.anio }} · {{ p.carrera }} · {{ p.facultad }}.</p>
  <table><tbody>
  {% for t in todos_tomos %}
    <tr><td style="width:24mm"><b>{{ t.numero_largo }}</b></td><td>{{ t.titulo }}{% if t.id == tomo.id %} <span class="chip lime">este tomo</span>{% endif %}</td></tr>
  {% endfor %}
  </tbody></table>
</section>

{# ───────────── Carátula interna (portada) ───────────── #}
<section class="pt">
  <div class="lima">
    {{ puntos_interior|safe }}
    <div class="marca"><img src="assets/logos/movo-marca.svg" alt="Movo"><span>movo</span></div>
    <div class="tomo-bloque"><div class="romano">{{ romano }}</div><div class="etq">Tomo</div></div>
  </div>
  <div class="cuerpo">
    <div class="eyebrow-c">Proyecto final {{ p.anio }} · {{ p.curso }} · Grupo {{ p.grupo }}</div>
    <h1 class="titulo">{{ t1 }}{% if t2 %}<br>{{ t2 }}{% endif %}</h1>
    <div class="desc">{{ tomo.portada_desc or tomo.bajada }}</div>
  </div>
  <div class="pie">
    <div class="grilla">
      <div>
        <div class="eyebrow-c s">Integrantes</div>
        {% for i in p.integrantes %}<div class="fila"><span>{{ i.apellido }}, {{ i.nombre }}</span><span class="leg">{{ i.legajo }}</span></div>{% endfor %}
      </div>
      <div class="bloques">
        <div class="grupo">
          <div class="eyebrow-c s">Equipo docente</div>
          {% for d in p.docentes %}<div>{{ d.nombre }} · {{ d.rol|replace("Jefa de Trabajos Prácticos", "JTP") }}</div>{% endfor %}
        </div>
        <div class="grupo">
          <div class="eyebrow-c s">Entrega</div>
          <div>Turno {{ p.turno }} · Proyecto independiente</div>
          <div>Córdoba, {{ fecha_mes }}</div>
        </div>
      </div>
    </div>
    <div class="logos">
      <img class="utn" src="assets/logos/utn-frc-extendido.svg" alt="UTN Facultad Regional Córdoba">
      <div class="vr"></div>
      <img class="isi" src="assets/logos/isi-reducido.svg" alt="Ingeniería en Sistemas de Información">
      <div class="catedra eyebrow-c s" style="margin-bottom:0">Cátedra {{ p.asignatura }}</div>
    </div>
  </div>
</section>

{# ───────────── Datos de la edición (reverso de la portada) ───────────── #}
<section class="datos-edicion">
  {# Página de créditos: elementos de una página legal editorial que aplican a una obra académica no comercial #}
  <p class="obra"><i>{{ p.software }}: {{ p.subtitulo|lower }}</i><br>{{ tomo.numero_largo }}: {{ tomo.titulo }}</p>

  <div class="bloque-c">
    <p>© {{ p.anio }}, {% for i in p.integrantes %}{{ i.nombre }} {{ i.apellido|title }}{% if loop.revindex == 2 %} y {% elif not loop.last %}, {% endif %}{% endfor %}.</p>
    <p><b>1.ª edición</b>, entrega final del {{ fecha_dia }}.</p>
    <p>Edita: {{ p.software }}, proyecto independiente. Córdoba, Argentina. {{ p.sitio }}</p>
    {% if p.edicion.imprenta %}<p>{{ p.edicion.imprenta }}{% if p.edicion.fecha_impresion %}, {{ p.edicion.fecha_impresion }}{% endif %}.</p>{% endif %}
    <p>ISBN, ISSN y depósito legal: no corresponden (edición académica de circulación no comercial).</p>
  </div>

  <div class="bloque-c">
    <p><b>{{ p.asignatura }}</b> · {{ p.carrera }} · {{ p.universidad }}, {{ p.facultad }}. Curso {{ p.curso }}, turno {{ p.turno }}, grupo {{ p.grupo }}, {{ p.anio }}.</p>
    <p>{% for d in p.docentes %}{{ d.rol }}: {{ d.nombre }}{% if not loop.last %}. {% endif %}{% endfor %}.</p>
  </div>

  <div class="bloque-c cred">
    <p><span>Autoría y desarrollo</span>{% for i in p.integrantes %}{{ i.nombre }} {{ i.apellido|title }}{% if not loop.last %}; {% endif %}{% endfor %}</p>
    <p><span>Identidad visual</span>Manual de Marca de {{ p.software }}</p>
    <p><span>Diseño de tapas</span>Equipo {{ p.software }}, con Claude Design</p>
    <p><span>Fotos del equipo</span>Sitio institucional de {{ p.software }}</p>
    <p><span>Composición</span>HTML y CSS de impresión (WeasyPrint) a partir del repositorio del proyecto. Texto en Inter, código y datos en JetBrains Mono. Diagramas en PlantUML, notación UML 2.</p>
    {% if p.edicion.papel %}<p><span>Papel</span>{{ p.edicion.papel }}</p>{% endif %}
  </div>

  <div class="bloque-c ficha-bib">
    {% for i in p.integrantes %}{{ i.apellido|title }}, {{ i.nombre }}{% if not loop.last %}; {% endif %}{% endfor %}.<br>
    <i>{{ p.software }}: {{ p.subtitulo|lower }}</i>. {{ tomo.numero_largo }}: {{ tomo.titulo }} / {% for i in p.integrantes %}{{ i.nombre }} {{ i.apellido|title }}{% if loop.revindex == 2 %} y {% elif not loop.last %}, {% endif %}{% endfor %}. 1.ª ed. Córdoba: {{ p.universidad }}, {{ p.facultad }}, {{ p.anio }}.<br>
    1. Logística colaborativa. 2. Ingeniería de software. 3. Proyecto final de carrera. I. Título.
  </div>

  <div class="bloque-c">
    <p><b>Cómo citar.</b> {% for i in p.integrantes %}{{ i.apellido|title }}, {% for n in i.nombre.split() %}{{ n[0] }}.{% if not loop.last %} {% endif %}{% endfor %}{% if not loop.last %}; {% endif %}{% endfor %} ({{ p.anio }}). <i>{{ p.software }}: {{ p.subtitulo|lower }}. {{ tomo.numero_largo }}: {{ tomo.titulo }}.</i> Proyecto Final, {{ p.carrera }}. {{ p.universidad }}, {{ p.facultad }}.</p>
  </div>

  <div class="bloque-c legal">
    <p>Reservados todos los derechos. Prohibida su reproducción total o parcial sin el permiso previo de los autores.</p>
    <p>Esta documentación describe el sistema tal como quedó construido al {{ fecha_dia }}; donde un documento previo y el código difieren, los tomos reflejan el código. Los datos de usuarios, envíos y pagos que aparecen en ejemplos, capturas y casos de prueba corresponden a cuentas y entornos de prueba, no a personas ni operaciones reales.</p>
    <p>Los nombres de productos y servicios de terceros mencionados (Mercado Pago, Google, Didit, Twilio, Amazon Web Services, entre otros) pertenecen a sus respectivos titulares y se citan solo para describir las integraciones.</p>
  </div>

  <div class="logos-c"><img src="assets/logos/utn-frc-extendido.svg" alt="UTN Facultad Regional Córdoba"><img class="isi" src="assets/logos/isi-reducido.svg" alt="Ingeniería en Sistemas de Información"></div>
</section>

{# ───────────── Ficha para Biblioteca (solo Tomo I) ───────────── #}
{% if tomo.ficha %}
<section class="ficha">
  <table>
    <tbody>
      <tr class="encabezado">
        <td style="width:30%"><img src="assets/logos/utn-frc-reducido.svg" alt="UTN FRC"></td>
        <td class="inst" colspan="4">FACULTAD REGIONAL CÓRDOBA<br>Ing. en Sistemas de Información<br>Proyecto Final</td>
      </tr>
      <tr><th>Cátedra</th><td colspan="4" style="text-align:center;font-weight:700">Proyecto Final</td></tr>
      <tr><th>Ámbito de aplicación</th><td colspan="4">{{ p.ambito }}</td></tr>
      <tr><th>Nombre del software</th><td colspan="4">{{ p.software }}: {{ p.subtitulo }}</td></tr>
      <tr><th>Objetivo</th><td colspan="4">{{ p.objetivo }}</td></tr>
      <tr><th>Metodología</th><td colspan="4">{{ p.metodologia }}</td></tr>
      <tr class="equipo">
        <th rowspan="{{ p.integrantes|length + 1 }}">Equipo de trabajo</th>
        <th class="sub">LEGAJO</th><th class="sub" colspan="2">APELLIDO, NOMBRES</th><th class="sub">MAIL DE CONTACTO</th>
      </tr>
      {% for i in p.integrantes %}
      <tr class="equipo"><td class="mono">{{ i.legajo }}</td><td colspan="2">{{ i.apellido }}, {{ i.nombre }}</td><td>{{ i.email }}</td></tr>
      {% endfor %}
      <tr><th>Curso</th><td colspan="4">{{ p.curso }}</td></tr>
      <tr><th>Docentes</th><td colspan="4">{% for d in p.docentes %}{{ d.nombre }} ({{ d.rol }}){% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>
      <tr><th>Año de cursado</th><td colspan="4">{{ p.anio }}</td></tr>
      <tr><th>Fecha de examen</th><td class="vacio"></td><th class="sub" style="width:18%">NOTA FINAL</th><td class="vacio" colspan="2"></td></tr>
    </tbody>
  </table>
  <p class="pie">Ficha para la Documentación en Biblioteca, según el formato provisto por la cátedra. Fecha de examen y nota final se completan en la instancia de evaluación.</p>
</section>
{% endif %}

{# ───────────── Presentación del tomo ───────────── #}
<section class="presentacion">
  <h2 class="unnumbered" id="presentacion-tomo" data-marcador="Presentación del {{ tomo.numero_largo|replace('Tomo','tomo') }}">Presentación del {{ tomo.numero_largo|replace('Tomo','tomo') }}</h2>
  {{ tomo.presentacion_html|safe }}
  <h3 class="unnumbered" id="organizacion-documentacion" data-marcador="Organización de la documentación">Organización de la documentación</h3>
  <table class="compacta">
    <thead><tr><th style="width:18%">Tomo</th><th>Contenido</th></tr></thead>
    <tbody>
    {% for t in todos_tomos %}
      <tr><td><b>{{ t.numero_largo }}</b>{% if t.id == tomo.id %} <span class="chip lime">este tomo</span>{% endif %}</td><td><b>{{ t.titulo }}.</b> {{ t.resumen }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
</section>

{# ───────────── Índice general ───────────── #}
<section class="indice">
  <h2 class="unnumbered" id="indice-general" data-marcador="Índice general">Índice general</h2>
  <ol>
  {% for d in documentos %}
    <li class="nivel-1"><a href="#{{ d.ancla }}"><span class="n">{{ '%02d' % d.n }}</span><span class="t">{{ d.titulo }}</span></a>
      <ol>
      {% for s in d.secciones %}
        <li class="nivel-{{ s.nivel }}"><a href="#{{ s.ancla }}"><span class="n">{{ s.numero }}</span><span class="t">{{ s.titulo }}</span></a></li>
      {% endfor %}
      </ol>
    </li>
  {% endfor %}
  </ol>
</section>

{% if figuras and indices_figuras_tablas %}
<section class="indice figuras">
  <h2 class="unnumbered" id="indice-figuras" data-marcador="Índice de figuras">Índice de figuras</h2>
  <ol>
  {% for f in figuras %}<li><a href="#{{ f.ancla }}"><span class="n">Figura {{ f.numero }}</span><span class="t">{{ f.titulo }}</span></a></li>{% endfor %}
  </ol>
  {% if tablas %}
  <h2 class="unnumbered" id="indice-tablas" data-marcador="Índice de tablas" style="margin-top:12mm">Índice de tablas</h2>
  <ol>
  {% for f in tablas %}<li><a href="#{{ f.ancla }}"><span class="n">Tabla {{ f.numero }}</span><span class="t">{{ f.titulo }}</span></a></li>{% endfor %}
  </ol>
  {% endif %}
</section>
{% endif %}

{# ───────────── Documentos ───────────── #}
{% for d in documentos %}
{% set sec2 = d.secciones|selectattr('nivel','equalto',2)|list %}
<section class="sep">
  <div class="lima">
    {{ puntos_interior|safe }}
    <div class="etq arriba">{{ tomo.numero_largo }} · {{ tomo.titulo }}</div>
    <div class="num-gigante">{{ '%02d' % d.n }}</div>
  </div>
  <div class="cuerpo">
    <span class="pildora">{{ d.instancia or (tomo.numero_largo ~ ' · Documento ' ~ d.n) }}</span>
    <h1 class="doc-titulo" id="{{ d.ancla }}" data-corto="{{ d.titulo_corto }}" data-marcador="{{ '%02d' % d.n }}. {{ d.titulo }}">{{ d.titulo }}</h1>
    {% if d.subtitulo %}<div class="desc">{{ d.subtitulo }}</div>{% endif %}
    {% if sec2 %}
    <nav class="contenido {{ 'compacto' if sec2|length > 8 else ('medio' if sec2|length > 6 else '') }}">
      <div class="eyebrow-c s">Contenido</div>
      <div class="lista">
      {% for s in sec2 %}<a class="fila" href="#{{ s.ancla }}"><span class="n">{{ s.numero }}</span><span class="t">{{ s.titulo }}</span></a>{% endfor %}
      </div>
    </nav>
    {% endif %}
  </div>
  <div class="pie-sep"><span>Movo · Proyecto Final {{ p.anio }}</span><span>Versión {{ d.version }} · {{ d.fecha }}</span></div>
</section>

<section class="documento" id="doc-{{ d.id }}">
  <div class="marca-doc" data-titulo="{{ d.titulo_corto }}"></div>
  <div class="preliminares">
    {% if d.historial %}
    <div class="bloque">
      <h2 class="unnumbered" id="{{ d.id }}-historial">Historial de revisión</h2>
      <table class="historial compacta">
        <thead><tr><th>Versión</th><th>Fecha</th><th>Autor</th><th>Descripción del cambio</th></tr></thead>
        <tbody>
        {% for h in d.historial %}<tr><td>{{ h.version }}</td><td>{{ h.fecha }}</td><td>{{ h.autor }}</td><td>{{ h.descripcion }}</td></tr>{% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if d.introduccion_html %}
    <div class="bloque">
      <h2 class="unnumbered" id="{{ d.id }}-introduccion">Introducción</h2>
      {{ d.introduccion_html|safe }}
    </div>
    {% endif %}
    {% if d.audiencia_html %}
    <div class="bloque">
      <h2 class="unnumbered" id="{{ d.id }}-audiencia">Audiencia</h2>
      {{ d.audiencia_html|safe }}
    </div>
    {% endif %}
  </div>
  {{ d.html|safe }}
</section>
{% endfor %}

{# ───────────── El equipo (cierre) ───────────── #}
<section class="equipo-pg">
  {{ puntos_interior|safe }}
  <div class="marca"><img src="assets/logos/movo-marca.svg" alt="Movo"><span>movo</span></div>
  <h2 class="unnumbered gigante" id="el-equipo" data-marcador="El equipo">{{ p.equipo.titular[0] }}<br>{{ p.equipo.titular[1] }}</h2>
  <div class="textos">{% for t in p.equipo.parrafos %}<p>{{ t }}</p>{% endfor %}</div>
  <div class="fotos">
    {% for i in p.integrantes %}
    <figure><img src="{{ i.foto }}" alt="{{ i.nombre }} {{ i.apellido|title }}"><figcaption><span class="nom">{{ i.nombre }} {{ i.apellido|title }}</span><span class="leg">Leg. {{ i.legajo }}</span></figcaption></figure>
    {% endfor %}
  </div>
  <div class="cierre">{{ p.equipo.cierre }}</div>
</section>

{# ───────────── Colofón ───────────── #}
<section class="colofon">
  <div class="centrado">
    <img class="marca-fin" src="assets/logos/movo-marca.svg" alt="">
    <div class="fin">Fin del {{ tomo.numero_largo|replace('Tomo','tomo') }}</div>
    <div class="lema">{{ p.lema }}. {{ p.software }} es un proyecto independiente de {{ p.carrera }}, {{ p.universidad }}, {{ p.facultad }}. Entrega final: {{ fecha_dia }}.</div>
  </div>
</section>

{% if edicion == 'digital' %}
{# ───────────── Contratapa (edición digital) ───────────── #}
<section class="pagina-tapa ultima">{% include '_tapa_contra.html.j2' %}</section>
{% endif %}

</body>
</html>
