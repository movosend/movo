@startuml arq-contenedores
' Vista de contenedores (C4 nivel 2): gateway, microservicios y almacenes de datos.
' En capas de arriba hacia abajo: clientes -> Nginx -> gateway -> microservicios -> datos.
' El gateway enruta a todos los microservicios (una flecha al bloque); qué servicio usa cada
' almacén va en el rótulo del almacén, para no cruzar ocho flechas sobre el diagrama.
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60
top to bottom direction

rectangle "Aplicación móvil\n(Expo)" as APP
rectangle "Panel de administración\n(Next.js)" as ADMIN
rectangle "Nginx\n(TLS)" as NGINX

package "Red interna Docker" {
  rectangle "API Gateway (Fastify)\nauth, límites, ruteo,\nproxy WebSocket" <<movo>> as GW

  rectangle "Microservicios (REST interno sobre HTTP)" as MS {
    rectangle "movo-svc-admin\nficha de usuarios,\nbitácora, admins" as AD
    rectangle "movo-svc-users\nidentidad, KYC,\nperfil, moderación" as U
    rectangle "movo-svc-shipments\nenvíos, ofertas, viajes,\nhandshake, tracking, chat,\nsoporte, disputas" as S
    rectangle "movo-svc-payments\nholds, capturas,\ntarjetas, cuenta corriente" as P
    rectangle "movo-svc-pricing-logistics\n(Python + FastAPI)\nprecios y optimización\nde rutas" as PR
  }

  database "Redis 7\nsesiones, límites, candados, estado\n<size:9>gateway · users · shipments · pricing</size>" as RD
  database "PostgreSQL 16\nun esquema por servicio\n<size:9>users · shipments · payments · admin</size>" as PG
}

APP --> NGINX : HTTPS / WSS
ADMIN --> NGINX : HTTPS
NGINX --> GW
GW --> MS
GW --> RD

AD --> U
AD --> S
AD --> P
S -left-> U
S <-right-> P : holds y\neventos
S --> PR : cotización\ny rutas

MS --> PG
MS --> RD

' Orden horizontal de las filas.
APP -[hidden]right- ADMIN
U -[hidden]right- S
S -[hidden]right- P
PG -[hidden]right- RD
' Los almacenes van debajo del bloque de microservicios.
PR -[hidden]down- RD
PR -[hidden]down- PG
@enduml
