// MOVO-267: movo-svc-payments adopta Prisma (ADR-011) antes de tener dominio
// propio, para que MOVO-111 (OAuth), MOVO-209 (hold) y MOVO-212 (captura) sumen
// sus modelos sobre una base ya desplegada en vez de resolver el setup a medias.
//
// moduleFormat = "cjs": el resto del servicio es CommonJS, mismo motivo que
// movo-svc-users/prisma/schema.prisma.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // Las tablas viven en el schema `payments` de Postgres (ADR-003: una sola
  // instancia compartida, un schema por servicio), no en `public`.
  schemas  = ["payments"]
}

// MOVO-111: cuenta de Mercado Pago vinculada por OAuth de cada transportista. Una
// fila por usuario (`userId` único): re-vincular es un upsert sobre la misma fila.
//
// - `unlinkedAt`: el transportista desvinculó a mano (DELETE /mp-connect). Se borran
//   los tokens y el status vuelve a `unlinked`. Es distinto de `revokedAt`, que marca
//   MOVO-243 cuando el refresh falla porque el acceso se revocó desde MP (status
//   `invalid`).
// - Tokens nullable solo porque se borran al desvincular. Nunca se loguean (ver
//   `src/config/logger.ts`).
//
// Una cuenta de MP vinculada a un solo usuario de Movo a la vez: índice único
// parcial `ON (mp_user_id) WHERE revoked_at IS NULL AND unlinked_at IS NULL`,
// agregado a mano en la migración SQL porque Prisma no representa índices
// parciales en su DSL (mismo gap que `Offer` en movo-svc-shipments).
model CarrierMpAccount {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Referencia lógica a users.users, sin FK real (ADR-003).
  userId         String    @unique(map: "carrier_mp_accounts_user_id_key") @map("user_id") @db.Uuid
  mpUserId       String    @map("mp_user_id")
  email          String?
  nickname       String?
  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  // Del vendedor: la usa el mobile para tokenizar la tarjeta del emisor (MOVO-209).
  publicKey      String?   @map("public_key")
  scope          String?
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz
  connectedAt    DateTime  @map("connected_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  unlinkedAt     DateTime? @map("unlinked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("carrier_mp_accounts")
  @@schema("payments")
}

enum HoldStatus {
  creating
  in_process
  authorized
  captured
  cancelled
  rejected

  @@map("hold_status")
  @@schema("payments")
}

enum HoldFailureReason {
  insufficient_funds
  card_rejected
  invalid_data
  platform_error

  @@map("hold_failure_reason")
  @@schema("payments")
}

// MOVO-209: reserva de fondos (Auth & Capture, `capture: false`) de un envío. Una fila
// por INTENTO de reserva (`shipmentId` + `attempt`): un rechazo cierra el intento y el
// siguiente crea otra fila con otra idempotency key; un reintento del mismo intento
// (timeout, respuesta perdida) reusa la fila y la key, así MP no crea un segundo hold.
//
// - La garantía de "un solo hold vivo por envío" la da un índice único PARCIAL sobre
//   `shipment_id` (`WHERE status IN ('creating','in_process','authorized','captured')`),
//   a mano en la migración porque Prisma no representa índices parciales.
// - `carrierId` es el usuario de Movo; `collectorId` el user id de MP del transportista
//   al momento del cobro (los tokens de MOVO-111 viven en `carrier_mp_accounts`).
// - Montos `numeric(12,2)`, nunca float. `shipmentId`/`carrierId` son referencias
//   lógicas, sin FK (ADR-003).
model Hold {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId         String             @map("shipment_id") @db.Uuid
  attempt            Int
  carrierId          String             @map("carrier_id") @db.Uuid
  collectorId        String             @map("collector_id")
  mpPaymentId        String?            @map("mp_payment_id")
  amountArs          Decimal            @map("amount_ars") @db.Decimal(12, 2)
  applicationFeeArs  Decimal            @map("application_fee_ars") @db.Decimal(12, 2)
  status             HoldStatus
  // `status_detail` crudo de MP (`pending_capture`, `cc_rejected_*`, ...).
  statusDetail       String?            @map("status_detail")
  failureReason      HoldFailureReason? @map("failure_reason")
  // sha256 de (card_token, email del pagador, medio de pago) del intento. Un reintento
  // con la misma key solo es seguro si el cuerpo coincide (MP reproduciría el pago
  // original); si no coincide, se busca el pago en MP antes de abrir otro intento.
  // Nunca el token en claro.
  requestFingerprint String?            @map("request_fingerprint")
  expiresAt          DateTime?          @map("expires_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([shipmentId, attempt], map: "holds_shipment_id_attempt_key")
  @@index([mpPaymentId], map: "holds_mp_payment_id_idx")
  @@map("holds")
  @@schema("payments")
}
