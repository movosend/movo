// MOVO-267: movo-svc-payments adopta Prisma (ADR-011) antes de tener dominio
// propio, para que MOVO-111 (OAuth), MOVO-209 (hold) y MOVO-212 (captura) sumen
// sus modelos sobre una base ya desplegada en vez de resolver el setup a medias.
//
// moduleFormat = "cjs": el resto del servicio es CommonJS, mismo motivo que
// movo-svc-users/prisma/schema.prisma.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // Las tablas viven en el schema `payments` de Postgres (ADR-003: una sola
  // instancia compartida, un schema por servicio), no en `public`.
  schemas  = ["payments"]
}

// MOVO-111: cuenta de Mercado Pago vinculada por OAuth de cada transportista. Una
// fila por usuario (`userId` único): re-vincular es un upsert sobre la misma fila.
//
// - `unlinkedAt`: el transportista desvinculó a mano (DELETE /mp-connect). Se borran
//   los tokens y el status vuelve a `unlinked`. Es distinto de `revokedAt`, que marca
//   MOVO-243 cuando el refresh falla porque el acceso se revocó desde MP (status
//   `invalid`).
// - Tokens nullable solo porque se borran al desvincular. Nunca se loguean (ver
//   `src/config/logger.ts`).
//
// Una cuenta de MP vinculada a un solo usuario de Movo a la vez: índice único
// parcial `ON (mp_user_id) WHERE revoked_at IS NULL AND unlinked_at IS NULL`,
// agregado a mano en la migración SQL porque Prisma no representa índices
// parciales en su DSL (mismo gap que `Offer` en movo-svc-shipments).
model CarrierMpAccount {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Referencia lógica a users.users, sin FK real (ADR-003).
  userId         String    @unique(map: "carrier_mp_accounts_user_id_key") @map("user_id") @db.Uuid
  mpUserId       String    @map("mp_user_id")
  email          String?
  nickname       String?
  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  // Del vendedor: la usa el mobile para tokenizar la tarjeta del emisor (MOVO-209).
  publicKey      String?   @map("public_key")
  scope          String?
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz
  connectedAt    DateTime  @map("connected_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  unlinkedAt     DateTime? @map("unlinked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("carrier_mp_accounts")
  @@schema("payments")
}

enum HoldStatus {
  creating
  in_process
  authorized
  captured
  cancelled
  rejected

  @@map("hold_status")
  @@schema("payments")
}

enum HoldFailureReason {
  insufficient_funds
  card_rejected
  invalid_data
  platform_error

  @@map("hold_failure_reason")
  @@schema("payments")
}

// MOVO-209: reserva de fondos (Auth & Capture, `capture: false`) de un envío. Una fila
// por INTENTO de reserva (`shipmentId` + `attempt`): un rechazo cierra el intento y el
// siguiente crea otra fila con otra idempotency key; un reintento del mismo intento
// (timeout, respuesta perdida) reusa la fila y la key, así MP no crea un segundo hold.
//
// - La garantía de "un solo hold vivo por envío" la da un índice único PARCIAL sobre
//   `shipment_id` (`WHERE status IN ('creating','in_process','authorized','captured')`),
//   a mano en la migración porque Prisma no representa índices parciales.
// - `carrierId` es el usuario de Movo; `collectorId` el user id de MP del transportista
//   al momento del cobro (los tokens de MOVO-111 viven en `carrier_mp_accounts`).
// - Montos `numeric(12,2)`, nunca float. `shipmentId`/`carrierId` son referencias
//   lógicas, sin FK (ADR-003).
model Hold {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId         String             @map("shipment_id") @db.Uuid
  attempt            Int
  carrierId          String             @map("carrier_id") @db.Uuid
  collectorId        String             @map("collector_id")
  mpPaymentId        String?            @map("mp_payment_id")
  amountArs          Decimal            @map("amount_ars") @db.Decimal(12, 2)
  applicationFeeArs  Decimal            @map("application_fee_ars") @db.Decimal(12, 2)
  // MOVO-311: `amountArs` es lo que se le cobra al emisor (precio + recargo por su deuda) y
  // `applicationFeeArs` la comisión + la deuda que se cobra. Acá queda el desglose, calculado una vez
  // por intento: el precio acordado (contra el que se compara un reintento), la comisión de Movo, el
  // descuento al transportista por su deuda y el recargo al emisor (completo; Movo absorbe la comisión
  // de MP sobre él, así que el fee lleva un poco menos). Al cerrarse el hold sin cobrar, un trigger anula
  // los movimientos `reserved` del ledger que lo referencian.
  baseAmountArs      Decimal            @map("base_amount_ars") @db.Decimal(12, 2)
  commissionArs      Decimal            @map("commission_ars") @db.Decimal(12, 2)
  debtOffsetArs      Decimal            @default(0) @map("debt_offset_ars") @db.Decimal(12, 2)
  debtSurchargeArs   Decimal            @default(0) @map("debt_surcharge_ars") @db.Decimal(12, 2)
  status             HoldStatus
  // Persiste si MP autorizó alguna vez el intento; `cancelled` también puede venir de `in_process`.
  wasAuthorized      Boolean            @default(false) @map("was_authorized")
  // `status_detail` crudo de MP (`pending_capture`, `cc_rejected_*`, ...).
  statusDetail       String?            @map("status_detail")
  failureReason      HoldFailureReason? @map("failure_reason")
  // sha256 de (card_token, email del pagador, medio de pago) del intento. Un reintento
  // con la misma key solo es seguro si el cuerpo coincide (MP reproduciría el pago
  // original); si no coincide, se busca el pago en MP antes de abrir otro intento.
  // Nunca el token en claro.
  requestFingerprint String?            @map("request_fingerprint")
  // MOVO-100: tarjeta guardada (`saved_cards.id`) con la que se creó el hold, sin FK
  // (la fila local se borra soft). La escribe MOVO-282; acá solo habilita el
  // `409 CARD_IN_USE` al dar de baja una tarjeta con un hold vivo.
  savedCardId        String?            @map("saved_card_id") @db.Uuid
  // MOVO-302 (historial de MOVO-28): quién pagó y con qué tarjeta, para listar "lo que pagó cada
  // emisor". `payerId` es el emisor (`payerUserId` de MOVO-282), referencia lógica a users.users sin
  // FK (ADR-003); los holds anteriores quedan en null. `cardLast4`/`cardBrand` salen de la respuesta
  // de MP (`card.last_four_digits`, `payment_method_id`), nunca del token; null si MP no los informa.
  payerId            String?            @map("payer_id") @db.Uuid
  cardLast4          String?            @map("card_last4") @db.VarChar(4)
  cardBrand          String?            @map("card_brand") @db.VarChar(32)
  // MOVO-285: comisión de MP de este pago (`mercadopago_fee` de `charges_details`, o de `fee_details` si el pago
  // ya se capturó) sobre el total que paga el emisor. Es el dato real de MP, no la estimación; null si MP todavía
  // no lo informó (hold anterior a MOVO-285, o respuesta sin el desglose).
  mpFeeArs           Decimal?           @map("mp_fee_ars") @db.Decimal(12, 2)
  expiresAt          DateTime?          @map("expires_at") @db.Timestamptz
  // MOVO-303: la fija un trigger la primera vez que el hold pasa a `cancelled` (ver la migración `hold_released_at`).
  releasedAt         DateTime?          @map("released_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  settlement         Settlement?
  ledgerEntries      UserLedgerEntry[]

  @@unique([shipmentId, attempt], map: "holds_shipment_id_attempt_key")
  @@index([mpPaymentId], map: "holds_mp_payment_id_idx")
  @@index([savedCardId], map: "holds_saved_card_id_idx")
  // MOVO-302: listados del historial por rol (emisor / transportista), más reciente primero.
  @@index([payerId, createdAt(sort: Desc), id(sort: Desc)], map: "holds_payer_id_created_at_idx")
  @@index([carrierId, createdAt(sort: Desc), id(sort: Desc)], map: "holds_carrier_id_created_at_idx")
  @@map("holds")
  @@schema("payments")
}

// MOVO-100 (DD-039): customer de la cuenta de Movo S.A. en Mercado Pago, uno por
// emisor. El `payer` del hold con tarjeta guardada es este customer (con `payer: {email}`
// MP responde 2002). `userId` es referencia lógica a users.users, sin FK (ADR-003).
model PayerCustomer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique(map: "payer_customers_user_id_key") @map("user_id") @db.Uuid
  mpCustomerId String   @unique(map: "payer_customers_mp_customer_id_key") @map("mp_customer_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("payer_customers")
  @@schema("payments")
}

// MOVO-100 (DD-039): tarjeta guardada del emisor en su customer de Movo. Solo ids de MP
// y metadatos de display: NUNCA el `card_token` (un solo uso), el número ni el CVV.
// Baja soft (`deletedAt`). Dos índices únicos PARCIALES, a mano en la migración porque
// Prisma no los representa: `(user_id, mp_card_id)` y un solo `is_default` entre las
// vivas de cada usuario, ambos `WHERE deleted_at IS NULL`.
// `alias` es un nombre de referencia que pone el usuario; es de Movo, no se manda a MP.
model SavedCard {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  mpCardId    String    @map("mp_card_id")
  brand       String
  last4       String
  expMonth    Int       @map("exp_month")
  expYear     Int       @map("exp_year")
  // MOVO-101: banco y tipo que devuelve MP al guardar, solo para mostrar. Nulas en las
  // tarjetas guardadas antes de esta migración.
  issuerName  String?   @map("issuer_name")
  paymentType String?   @map("payment_type")
  isDefault   Boolean   @default(false) @map("is_default")
  alias       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  @@index([userId], map: "saved_cards_user_id_idx")
  @@map("saved_cards")
  @@schema("payments")
}

enum SettlementStatus {
  processing
  credited
  failed
  escalated

  @@map("settlement_status")
  @@schema("payments")
}

// MOVO-306: qué originó la captura (ver `SettlementKind` en @movo/shared).
enum SettlementKind {
  delivery
  cancellation_penalty
  // MOVO-337: captura parcial de una disputa resuelta en parcial (no es una penalidad).
  dispute_partial

  @@map("settlement_kind")
  @@schema("payments")
}

// MOVO-212: liquidación de un envío (captura del hold + split). UNA fila por envío
// (`shipment_id` único): es la base de la idempotencia del cobro, un segundo pedido de
// captura encuentra la fila y no vuelve a cobrar. `processing` se escribe ANTES de llamar
// a MP, así una caída entre la captura y el desglose deja rastro y se puede completar.
//
// - `gross_amount_ars` = monto del hold (nunca otro, AC3); `commission_ars` = el
//   `application_fee` del hold menos la deuda cobrada (MOVO-311). `mp_fee_ars` y
//   `net_amount_ars` salen de `fee_details` / `net_received_amount` de MP y son null
//   hasta que MP confirma la captura.
// - Montos `numeric(12,2)`, nunca float. `shipmentId`/`carrierId` son referencias
//   lógicas, sin FK (ADR-003); `holdId` sí es FK interna del mismo schema.
model Settlement {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId            String           @unique(map: "settlements_shipment_id_key") @map("shipment_id") @db.Uuid
  holdId                String           @unique(map: "settlements_hold_id_key") @map("hold_id") @db.Uuid
  carrierId             String           @map("carrier_id") @db.Uuid
  mpPaymentId           String           @map("mp_payment_id")
  grossAmountArs        Decimal          @map("gross_amount_ars") @db.Decimal(12, 2)
  mpFeeArs              Decimal?         @map("mp_fee_ars") @db.Decimal(12, 2)
  commissionArs         Decimal          @map("commission_ars") @db.Decimal(12, 2)
  netAmountArs          Decimal?         @map("net_amount_ars") @db.Decimal(12, 2)
  // MOVO-311: deuda de la cuenta corriente cobrada en este envío, aparte de `commissionArs` (que queda
  // solo la comisión de Movo): el descuento al transportista y el recargo que pagó el emisor.
  debtOffsetArs         Decimal          @default(0) @map("debt_offset_ars") @db.Decimal(12, 2)
  debtSurchargeArs      Decimal          @default(0) @map("debt_surcharge_ars") @db.Decimal(12, 2)
  // Parte del `application_fee` retenido que corresponde al recargo (recargo menos la comisión de MP que
  // absorbe Movo): para mostrarle al transportista su cobro sin el recargo del emisor.
  debtSurchargeFeeArs   Decimal          @default(0) @map("debt_surcharge_fee_ars") @db.Decimal(12, 2)
  // Bruto y fee de MP tal como los ve el transportista (sin el recargo del emisor), fijados al acreditar. Null hasta entonces.
  carrierGrossAmountArs Decimal?         @map("carrier_gross_amount_ars") @db.Decimal(12, 2)
  carrierMpFeeArs       Decimal?         @map("carrier_mp_fee_ars") @db.Decimal(12, 2)
  status                SettlementStatus
  kind                  SettlementKind   @default(delivery)
  // Motivo si quedó `failed` (ver `SettlementFailureReason` en @movo/shared).
  failureReason         String?          @map("failure_reason")
  // `status_detail` crudo de MP al capturar (`accredited`, ...).
  statusDetail          String?          @map("status_detail")
  // MOVO-213: reintentos de la captura. `attempts` cuenta los intentos fallidos con fallo reintentable (un fallo
  // que no se arregla reintentando escala sin sumar); `next_attempt_at` es cuándo toca el próximo (null si no hay);
  // `last_error` el último error crudo; `escalated_at`/`escalation_reason` si pasó a proceso manual.
  attempts              Int              @default(0)
  nextAttemptAt         DateTime?        @map("next_attempt_at") @db.Timestamptz
  lastError             String?          @map("last_error")
  escalatedAt           DateTime?        @map("escalated_at") @db.Timestamptz
  escalationReason      String?          @map("escalation_reason")
  capturedAt            DateTime?        @map("captured_at") @db.Timestamptz
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  hold                  Hold             @relation(fields: [holdId], references: [id])
  refunds               Refund[]

  @@index([status, nextAttemptAt], map: "settlements_status_next_attempt_idx")
  @@map("settlements")
  @@schema("payments")
}

// MOVO-336: estado de un intento de reembolso (ver `RefundStatus` en @movo/shared).
enum RefundStatus {
  processing
  succeeded
  failed
  fallback_to_ledger

  @@map("refund_status")
  @@schema("payments")
}

// MOVO-336: reembolso de un pago ya capturado, una fila por INTENTO. Nace en `processing` ANTES de llamar a MP (mismo
// criterio que `Settlement`): una caída entre el pedido y la respuesta deja rastro y se completa con la misma key.
//
// - `attempt` es el `<n>` de `mp_idempotency_key` (`movo-refund-<settlementId>-<n>`): MP guarda la respuesta de una key,
//   así que un intento nuevo tras un `failed` usa otro `n` y no replica el rechazo.
// - `request_key` es la `idempotencyKey` del llamador. Un índice único parcial a mano (`settlement_id`, `request_key`
//   mientras no esté `failed`) deja UNA fila viva por key; Prisma no representa índices parciales.
// - `shipment_id`/`hold_id`/`carrier_id`/`mp_payment_id` se copian de la liquidación para el historial y el webhook,
//   que buscan por pago sin pasar por ella. `ledger_entry_id` es lógico (sin FK): lo deja el fallback.
// - `mp_response` es el cuerpo de MP sin datos sensibles (solo campos del reembolso, nunca tokens).
model Refund {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementId       String       @map("settlement_id") @db.Uuid
  shipmentId         String       @map("shipment_id") @db.Uuid
  holdId             String       @map("hold_id") @db.Uuid
  carrierId          String       @map("carrier_id") @db.Uuid
  mpPaymentId        String       @map("mp_payment_id")
  attempt            Int
  amountArs          Decimal      @map("amount_ars") @db.Decimal(12, 2)
  reason             String
  requestKey         String       @map("request_key")
  // Hash de (monto pedido o total, motivo): una key reusada con otro cuerpo es 409.
  requestFingerprint String       @map("request_fingerprint")
  adminId            String       @map("admin_id") @db.Uuid
  mpIdempotencyKey   String       @unique(map: "refunds_mp_idempotency_key_key") @map("mp_idempotency_key")
  status             RefundStatus @default(processing)
  // Ver `RefundFailureReason` en @movo/shared.
  failureReason      String?      @map("failure_reason")
  mpRefundId         String?      @map("mp_refund_id")
  mpResponse         Json?        @map("mp_response")
  lastError          String?      @map("last_error")
  ledgerEntryId      String?      @map("ledger_entry_id") @db.Uuid
  // Cuándo llegó a un estado final (`succeeded`, `failed` o `fallback_to_ledger`): la fecha del movimiento en el historial.
  completedAt        DateTime?    @map("completed_at") @db.Timestamptz
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  settlement         Settlement   @relation(fields: [settlementId], references: [id])

  @@unique([settlementId, attempt], map: "refunds_settlement_attempt_key")
  @@index([mpPaymentId], map: "refunds_mp_payment_id_idx")
  @@index([holdId], map: "refunds_hold_id_idx")
  @@map("refunds")
  @@schema("payments")
}

enum MpWebhookNotificationStatus {
  pending
  processed
  ignored
  unverifiable
  failed

  @@map("mp_webhook_notification_status")
  @@schema("payments")
}

enum HoldProviderEventKind {
  cancelled
  expired
  rejected

  @@map("hold_provider_event_kind")
  @@schema("payments")
}

// MOVO-268: inbox de las notificaciones del webhook de Mercado Pago (tópico `payment`).
// La ruta valida la firma, inserta acá y responde 200 enseguida (AC7); el procesamiento
// corre después, y un barrido reintenta lo que quedó `pending` con backoff hasta un tope.
//
// - `mpNotificationId` es el `id` del body de MP, que se repite en cada reenvío: el
//   índice único descarta el duplicado en el insert (AC6).
// - `pendingHoldEvent`: el hold ya cambió de estado por esta notificación pero todavía no
//   se le avisó a svc-shipments. Se escribe en la MISMA transacción que el cambio del hold,
//   así un reintento sabe que tiene que volver a avisar aunque el hold ya no esté vivo.
// - `holdId` es una referencia lógica, sin FK: los tests truncan `holds` por separado.
model MpWebhookNotification {
  id                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mpNotificationId       String                      @unique(map: "mp_webhook_notifications_mp_notification_id_key") @map("mp_notification_id")
  topic                  String
  action                 String?
  mpPaymentId            String                      @map("mp_payment_id")
  // `user_id` del body: el vendedor (transportista) dueño del pago.
  mpUserId               String?                     @map("mp_user_id")
  liveMode               Boolean?                    @map("live_mode")
  status                 MpWebhookNotificationStatus @default(pending)
  attempts               Int                         @default(0)
  nextAttemptAt          DateTime                    @default(now()) @map("next_attempt_at") @db.Timestamptz
  // Qué hizo el procesamiento (`hold_cancelled`, `chargeback_recorded`, ...), para auditar.
  outcome                String?
  lastError              String?                     @map("last_error")
  holdId                 String?                     @map("hold_id") @db.Uuid
  pendingHoldEvent       HoldProviderEventKind?      @map("pending_hold_event")
  pendingHoldEventDetail String?                     @map("pending_hold_event_detail")
  processedAt            DateTime?                   @map("processed_at") @db.Timestamptz
  receivedAt             DateTime                    @default(now()) @map("received_at") @db.Timestamptz
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, nextAttemptAt], map: "mp_webhook_notifications_status_next_attempt_at_idx")
  @@map("mp_webhook_notifications")
  @@schema("payments")
}

enum PaymentProviderEventKind {
  chargeback
  refund
  mediation

  @@map("payment_provider_event_kind")
  @@schema("payments")
}

// MOVO-268 AC5: lo que MP hizo sobre un pago por fuera de Movo (contracargo, reembolso,
// mediación abierta por el pagador). Hoy no existe la liquidación (MOVO-212): esta tabla
// es el registro, y MOVO-212 la enlaza a su liquidación por `mp_payment_id`. Qué pasa con
// el envío queda fuera de alcance (disputas, MOVO-30/34).
//
// Una fila por (pago, estado de MP): la misma notificación procesada dos veces, o dos
// notificaciones del mismo cambio, no generan dos filas ni dos alertas (AC6).
model PaymentProviderEvent {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Referencias lógicas, sin FK (mismo criterio que `MpWebhookNotification.holdId`).
  holdId         String                   @map("hold_id") @db.Uuid
  shipmentId     String                   @map("shipment_id") @db.Uuid
  mpPaymentId    String                   @map("mp_payment_id")
  kind           PaymentProviderEventKind
  mpStatus       String                   @map("mp_status")
  mpStatusDetail String?                  @map("mp_status_detail")
  // Lo que MP informa como devuelto (`transaction_amount_refunded`), si viene.
  amountArs      Decimal?                 @map("amount_ars") @db.Decimal(12, 2)
  holdStatus     HoldStatus               @map("hold_status")
  alertedAt      DateTime?                @map("alerted_at") @db.Timestamptz
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  @@unique([mpPaymentId, mpStatus], map: "payment_provider_events_mp_payment_id_mp_status_key")
  @@index([shipmentId], map: "payment_provider_events_shipment_id_idx")
  @@map("payment_provider_events")
  @@schema("payments")
}

enum LedgerEntryType {
  cancellation_penalty
  penalty_capture
  cash_commission
  fee_offset
  payment_surcharge
  voluntary_payment
  manual_adjustment

  @@map("ledger_entry_type")
  @@schema("payments")
}

enum LedgerEntryStatus {
  pending
  reserved
  settled
  voided

  @@map("ledger_entry_status")
  @@schema("payments")
}

enum LedgerRole {
  sender
  carrier

  @@map("ledger_role")
  @@schema("payments")
}

// MOVO-309 (DD-044): cuenta corriente del USUARIO (no de un rol). Solo inserción, con
// triggers en la migración: lo único que cambia de una fila es `status`. `amount_ars` es con
// signo (positivo = debe). `createdAt` lo pone la app (ms) y no Postgres (µs) para que el
// cursor de paginación no pierda precisión. Referencias lógicas, sin FK (ADR-003), salvo
// `hold_id` que es del mismo schema.
model UserLedgerEntry {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  roleAtOrigin       LedgerRole?       @map("role_at_origin")
  type               LedgerEntryType
  // Con signo, nunca float.
  amountArs          Decimal           @map("amount_ars") @db.Decimal(12, 2)
  status             LedgerEntryStatus @default(pending)
  shipmentId         String?           @map("shipment_id") @db.Uuid
  holdId             String?           @map("hold_id") @db.Uuid
  hold               Hold?             @relation(fields: [holdId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentId          String?           @map("payment_id")
  reason             String?
  adminId            String?           @map("admin_id") @db.Uuid
  idempotencyKey     String            @unique(map: "user_ledger_entries_idempotency_key_key") @map("idempotency_key")
  // Hash del cuerpo, para distinguir un reintento legítimo de una key reusada con otros datos.
  requestFingerprint String            @map("request_fingerprint")
  // Milisegundos: es la precisión del cursor de paginación (la app la fija al insertar).
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "user_ledger_entries_user_id_created_at_id_idx")
  @@index([shipmentId], map: "user_ledger_entries_shipment_id_idx")
  @@index([holdId], map: "user_ledger_entries_hold_id_idx")
  @@map("user_ledger_entries")
  @@schema("payments")
}

enum BalanceAttemptStatus {
  creating
  pending
  approved
  rejected
  failed

  @@map("balance_attempt_status")
  @@schema("payments")
}

// MOVO-312: un intento de "Pagar mi saldo" (Checkout API: tarjeta guardada + CVV, pago directo a la cuenta cobradora de
// Movo). Su `id` es el `external_reference` del pago de MP: con él el webhook y la recuperación de un intento sin
// respuesta lo reconocen. El movimiento del ledger (`voluntary_payment`) se asienta una sola vez por su
// `idempotency_key` (`balance-payment:<id>`), no por el estado de esta fila.
// Un índice único parcial a mano (`user_id` mientras `creating`/`pending`) deja un solo intento abierto por usuario: así lo
// que está en vuelo nunca suma más que la deuda.
model BalancePaymentAttempt {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String               @map("user_id") @db.Uuid
  // Lo que el usuario quiso pagar en este intento: siempre positivo (el ledger lo asienta negativo).
  amountArs          Decimal              @map("amount_ars") @db.Decimal(12, 2)
  status             BalanceAttemptStatus @default(creating)
  // Tarjeta guardada (`saved_cards.id`) con la que se pagó; sin FK, solo para el historial.
  savedCardId        String?              @map("saved_card_id") @db.Uuid
  // Hash del cuerpo del pedido (token, tarjeta, medio de pago): un reintento con la misma key solo es seguro si coincide.
  requestFingerprint String               @map("request_fingerprint")
  // Pago de MP: único, así un mismo pago no puede asentar dos intentos.
  mpPaymentId        String?              @unique(map: "balance_payment_attempts_mp_payment_id_key") @map("mp_payment_id")
  statusDetail       String?              @map("status_detail")
  failureReason      HoldFailureReason?   @map("failure_reason")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, status], map: "balance_payment_attempts_user_id_status_idx")
  // El historial del emisor (MOVO-303) lista los aprobados, más recientes primero.
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "balance_payment_attempts_user_id_created_at_idx")
  @@map("balance_payment_attempts")
  @@schema("payments")
}
