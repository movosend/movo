PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/movo
REDIS_URL=redis://localhost:6379
JWT_SECRET=changeme

# Mercado Pago (MOVO-267): credenciales de la app Marketplace del ambiente.
# - Sandbox: app "movosend", creada logueado como la cuenta de prueba Marketplace
#   (si la app es de una cuenta real, MP rechaza el pago con 2034). Los valores
#   están en el archivo de credenciales compartido por fuera del repo, ver
#   docs/payments/mercadopago-spike/README.md -> Setup.
# - Producción: app creada desde la cuenta real de Movo.
# Los pagos se crean con el access_token OAuth de cada transportista, no con
# uno de la app: acá no va ningún access token.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Tiene que coincidir exacto con la Redirect URI cargada en el panel de la app.
MP_REDIRECT_URI=
# Clave secreta de webhooks del panel de la app (valida x-signature, MOVO-268).
MP_WEBHOOK_SECRET=
# Solo sandbox: agrega test_token=true al canje de OAuth (token TEST- del vendedor).
MP_TEST_MODE=false
