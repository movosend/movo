PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/movo
REDIS_URL=redis://localhost:6379
JWT_SECRET=changeme

# Mercado Pago (MOVO-267): credenciales de la app Marketplace del ambiente.
# - Sandbox: app "movosend", creada logueado como la cuenta de prueba Marketplace
#   (si la app es de una cuenta real, MP rechaza el pago con 2034). Los valores
#   están en el archivo de credenciales compartido por fuera del repo, ver
#   docs/payments/mercadopago-spike/README.md -> Setup.
# - Producción: app creada desde la cuenta real de Movo.
# Los pagos se crean con el access_token OAuth de cada transportista, no con
# uno de la app: acá no va ningún access token.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Tiene que coincidir exacto con la Redirect URI cargada en el panel de la app.
# Termina en `/payments/mp-connect/callback`: de lo que queda antes se deriva la base pública del API
# (`back_urls` y `notification_url` de "Pagar mi saldo", MOVO-312). Sin ella, ese checkout responde 503.
MP_REDIRECT_URI=
# Clave secreta de webhooks del panel de la app (valida x-signature, MOVO-268).
MP_WEBHOOK_SECRET=
# Key de AES-256-GCM para cifrar en la base los tokens OAuth de los transportistas
# (MOVO-111). Base64 de 32 bytes, una distinta por ambiente: `openssl rand -base64 32`.
# Si se pierde o cambia, los tokens guardados no se pueden descifrar y hay que re-vincular.
MP_TOKEN_ENCRYPTION_KEY=
# Solo sandbox: agrega test_token=true al canje de OAuth (token TEST- del vendedor).
MP_TEST_MODE=false
# ADR-048: cuenta de Mercado Pago de Movo S.A. que cobra los pagos de saldo (MOVO-312). Producción: Access Token y
# Public Key productivos del panel de la cuenta. Sandbox: token TEST- del OAuth de la cuenta de prueba Movo S.A.
# (dura 180 días, se renueva con scripts/collector-oauth.mjs). MP_COLLECTOR_MP_USER_ID es su user id. Sin las tres, pagar el saldo
# responde 503.
MP_COLLECTOR_ACCESS_TOKEN=
MP_COLLECTOR_PUBLIC_KEY=
MP_COLLECTOR_MP_USER_ID=

# MOVO-209: cuánto sostiene MP un hold sin capturar; de ahí sale `expires_at` de la
# reserva. PROVISORIO: 5 días es el mínimo de los plazos que documenta MP (5 o 7). El
# valor real sale de la medición de MOVO-215 y se ajusta acá, no en el código.
MP_HOLD_VALIDITY_DAYS=5
# Comisión de Movo (application_fee del hold). La lee @movo/shared, no el envSchema:
# tiene que valer lo mismo que en movo-svc-shipments, que calcula el precio con ella.
MOVO_COMMISSION_RATE=0.15
# MOVO-311: estimado de la comisión de MP que Movo absorbe sobre el recargo por deuda del emisor (así el
# transportista recibe lo mismo). Lo lee @movo/shared, igual que en movo-svc-shipments.
MP_TRANSACTION_FEE_RATE=0.0499
# MOVO-311: tope de la deuda de la cuenta corriente que se cobra en un envío, como fracción del precio. Vale
# igual para el descuento al transportista y el recargo al emisor; lo que no entra queda para la próxima
# operación. Entre 0 (no se cobra deuda en los holds) y 0.5.
DEBT_COLLECTION_MAX_RATE=0.3

# SANDBOX (MOVO-209 AC10): el pagador del hold tiene que ser una cuenta de prueba de tipo
# COMPRADOR y `payerEmail` su email REAL (se copia de su perfil en MP). Con un email
# inventado MP crea un comprador invitado y responde 2034 "Invalid users involved". El
# vendedor (transportista) y el dueño de la app también tienen que ser cuentas de prueba.
# Ver docs/payments/mercadopago-spike/SOLUCION-FINAL.md §1-2.

# MOVO-243: renovacion automatica de los tokens OAuth de los transportistas. El barrido
# corre cada INTERVAL minutos y renueva lo que vence dentro de WINDOW dias (el access_token
# de MP dura 180). Un fallo transitorio se reintenta en la corrida siguiente.
MP_TOKEN_REFRESH_SWEEP_ENABLED=true
MP_TOKEN_REFRESH_SWEEP_INTERVAL_MINUTES=60
MP_TOKEN_REFRESH_WINDOW_DAYS=30
# MOVO-100 (ADR-039): tarjetas guardadas del emisor en un customer de la cuenta de Movo S.A.
# - MP_PUBLIC_KEY: public_key con la que el mobile tokeniza la tarjeta al guardarla. Solo genera
#   el token de un solo uso; la tarjeta queda siempre en un customer de Movo S.A., no en la cuenta
#   dueña de esta key. En sandbox tiene que ser una TEST- (la APP_USR- da 404 card not found): en
#   dev se usa la de un Vendedor de prueba. En producción se espera la de Movo (MOVO-283).
# - El token de Movo para crear customers sale de MP_CLIENT_ID/MP_CLIENT_SECRET
#   (client_credentials, test_token=true si MP_TEST_MODE=true); no hace falta cargarlo.
MP_PUBLIC_KEY=
# Solo sandbox (MP_TEST_MODE=true): JSON userId -> email de una cuenta de prueba COMPRADOR.
# El customer de MP tiene que usar ese email (con otro, 225 "Invalid test user email"), y la
# cuenta de Movo de cada tester tiene su email real. Ej: {"<uuid>":"test_user_123@testuser.com"}
MP_TEST_PAYER_EMAILS=
# El email del customer se pide a svc-users. El default ya es el servicio en movo-net.
# USERS_SERVICE_URL=http://movo-svc-users:3000

# MOVO-268: webhook de MP (el secreto de la firma es MP_WEBHOOK_SECRET, más arriba).
# svc-shipments, al que se le avisa cuando MP cancela o vence un hold. En compose el
# default ya coincide con el nombre del servicio; en local, el puerto con el que levantes shipments.
SHIPMENTS_SERVICE_URL=http://localhost:3000
# Reintentos del procesamiento de una notificación (backoff 1, 2, 4... min hasta 6 h) y
# cada cuánto corre el barrido que los ejecuta.
MP_WEBHOOK_MAX_ATTEMPTS=10
MP_WEBHOOK_SWEEP_INTERVAL_MINUTES=1
MP_WEBHOOK_SWEEP_ENABLED=true

# MOVO-268: alertas al equipo (contracargos, reembolsos externos, holds perdidos con el
# paquete en camino, notificaciones que no se pudieron procesar). `console` solo loguea;
# `telegram` además manda al chat del equipo (mismo bot que los avisos de EAS sirve).
ALERT_PROVIDER=console
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Prefijo de cada alerta para distinguir ambientes en el mismo chat (`dev`, `prod`).
ALERT_ENVIRONMENT_LABEL=
