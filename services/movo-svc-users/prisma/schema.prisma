// Modela exactamente lo que ya crearon las migraciones SQL existentes
// (20260728160000_create_users_schema.sql + 20260731200000_align_user_enums_with_shared.sql,
// esta última alineó los enums a los valores de @movo/shared, MOVO-91) — no se corre
// `prisma db pull` a propósito, para controlar el naming/mapeo explícitamente.
//
// moduleFormat = "cjs": el resto del servicio es CommonJS ("type": "commonjs" en
// package.json, tsconfig con module: "commonjs") — se mantiene así para no forzar la
// conversión a ESM de todo el servicio solo por adoptar Prisma.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // Las tablas viven en el schema `users` de Postgres (ADR-003: una sola instancia
  // compartida, un schema por servicio), no en `public`.
  schemas  = ["users"]
}

enum UserRole {
  sender
  carrier
  admin

  // Nombre real del tipo en Postgres (histórico: se llamaba distinto antes de MOVO-91).
  @@map("user_role_enum")
  @@schema("users")
}

enum KycStatus {
  not_started
  pending
  approved
  rejected
  expired
  // MOVO-72: mapea "In Review" de Didit.me. Agregado al final -- nunca se renombra un
  // valor existente (mismo criterio que ApiErrorCode en @movo/shared).
  manual_review

  @@map("kyc_status_enum")
  @@schema("users")
}

// MOVO-72: distingue las dos verificaciones que ya modela el DER sobre la misma tabla
// (kyc_status_identity / kyc_status_license en User). MOVO-15 empieza a escribir filas
// `license` (antes solo `identity`).
enum VerificationType {
  identity
  license

  @@map("verification_type_enum")
  @@schema("users")
}

// MOVO-15: ciclo de vida del carnet en sí (distinto del ciclo de vida del intento de
// verificación, que ya cubre KycStatus) -- `pending`/`expired` quedan modelados para
// el día que exista limpieza por vencimiento real del carnet (fuera de alcance de esta
// US, ver drivers_license.status abajo).
enum DriversLicenseStatus {
  pending
  verified
  expired

  @@map("drivers_license_status_enum")
  @@schema("users")
}

enum AccountStatus {
  active
  banned
  deleted

  @@map("account_status_enum")
  @@schema("users")
}

// MOVO-106: plataforma del dispositivo que registró el push token -- solo las dos que
// soporta Expo Push (no hay "web" todavía, el mobile es la única app cliente).
enum PushPlatform {
  ios
  android

  @@map("push_platform_enum")
  @@schema("users")
}

model User {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String        @unique(map: "users_email_key")
  phone             String        @unique(map: "users_phone_key")
  firstName         String        @map("first_name")
  lastName          String        @map("last_name")
  passwordHash      String        @map("password_hash")
  dni               String?
  phoneVerified     Boolean       @default(false) @map("phone_verified")
  photoUrl          String?       @map("photo_url")
  kycStatusIdentity KycStatus     @default(not_started) @map("kyc_status_identity")
  kycStatusLicense  KycStatus     @default(not_started) @map("kyc_status_license")
  status            AccountStatus @default(active) @map("status")
  bannedUntil       DateTime?     @map("banned_until") @db.Timestamptz
  birthdate         DateTime?     @db.Date
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  // El trigger users.update_updated_at_column() de la migración original ya mantiene
  // esta columna al día en cada UPDATE -- @updatedAt hace que Prisma también la
  // pise en cada write, de forma redundante pero consistente con el trigger.
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  roles             UserRoleGrant[]
  kycVerifications  KycVerification[]
  addresses         Address[]
  pushTokens        PushToken[]
  driversLicense    DriversLicense?

  // users_email_lower_idx (índice único funcional sobre LOWER(email)) no tiene
  // equivalente declarable en schema.prisma (Prisma no modela expression indexes).
  // Sigue existiendo en la DB igual (viene de la migración original); las búsquedas
  // case-insensitive se resuelven en el repositorio con el filtro `mode: "insensitive"`.

  @@map("users")
  @@schema("users")
}

model UserRoleGrant {
  userId    String   @map("user_id") @db.Uuid
  role      UserRole
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
  @@schema("users")
}

// MOVO-72: tabla `KYC_VERIFICATION` del DER ("tiene intentos de", 1 a N desde User).
// User.kycStatusIdentity/kycStatusLicense siguen siendo el caché de lectura rápida
// (nota del propio DER); esta tabla es el historial de intentos, un registro por
// sesión de verificación creada.
model KycVerification {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  verificationType  VerificationType  @map("verification_type")
  provider          String
  // `session_id` de Didit -- único: un intento por sesión, y es la clave con la que el
  // webhook (AC7) encuentra a qué intento corresponde un evento entrante.
  externalSessionId String            @unique(map: "kyc_verification_external_session_id_key") @map("external_session_id")
  status            KycStatus
  requestedAt       DateTime          @default(now()) @map("requested_at") @db.Timestamptz
  resolvedAt        DateTime?         @map("resolved_at") @db.Timestamptz
  // Payload del webhook de Didit REDACTADO (whitelist de campos seguros -- nunca imagen
  // de documento ni dato biométrico, AC9). Ver kyc.service.ts#buildRedactedRawDecision.
  rawDecision       Json?             @map("raw_decision")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  driversLicenses   DriversLicense[]

  @@index([userId], map: "kyc_verification_user_id_idx")
  @@map("kyc_verification")
  @@schema("users")
}

// MOVO-73: tabla `address` del DER (docs/movo_der.dbml), diseñada como patrón de
// libreta de direcciones (1:N desde User, con label/is_default) pero nunca
// implementada hasta ahora. Esta US solo crea la primera dirección al registrarse
// (label: null, is_default: true) — el resto del CRUD de libreta de direcciones
// (agregar/editar/marcar otra como default) queda fuera de alcance, sin ticket propio
// todavía.
model Address {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  label           String?
  isDefault       Boolean  @default(false) @map("is_default")
  street          String
  streetNumber    String   @map("street_number")
  floorApartment  String?  @map("floor_apartment")
  city            String
  province        String
  postalCode      String   @map("postal_code")
  // No se pide en el wizard (la app es solo Argentina hoy, mismo criterio que el
  // regex de teléfono en auth.schema.ts) — se hardcodea "AR" al crear.
  country         String
  // Poblados por el paso de mapa/geocoding del wizard de registro (MOVO-73) — a
  // diferencia del resto de las columnas, el DER no los marca nullable, así que se
  // exige siempre un valor confirmado antes de crear la cuenta.
  lat             Decimal  @db.Decimal
  long            Decimal  @db.Decimal
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "address_user_id_idx")
  @@map("address")
  @@schema("users")
}

// MOVO-106: registro de push token por dispositivo (AC1) -- un usuario puede tener N
// dispositivos, cada uno con un solo token vigente (índice único (user_id, device_id),
// permite multi-dispositivo). FK real a users.users (mismo schema, mismo criterio que
// Address/KycVerification).
model PushToken {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  expoPushToken  String       @map("expo_push_token")
  deviceId       String       @map("device_id")
  platform       PushPlatform
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId], map: "push_token_user_id_device_id_key")
  @@map("push_token")
  @@schema("users")
}

// MOVO-15: tabla `drivers_license` del DER (docs/movo_der.dbml) -- el registro del
// carnet en sí, distinto de `kyc_verification` (que es el log de intentos, 1 a N). Un
// carnet tiene un ciclo de vida propio (vencimiento, renovación) que un DNI verificado
// no tiene en el resto del sistema, por eso vive en su propia tabla en vez de
// reutilizar solo el caché de `User.kycStatusLicense`. `userId` único: se upsertea en
// cada re-verificación aprobada (kyc.service.ts#applyTerminalDecision), no se acumula
// historial acá -- eso ya lo tiene `kyc_verification`.
model DriversLicense {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @unique(map: "drivers_license_user_id_key") @map("user_id") @db.Uuid
  kycVerificationId String               @map("kyc_verification_id") @db.Uuid
  // Fecha de vencimiento impresa en el documento -- extraída de
  // `decision.id_verifications[0].expiration_date` (feature "ID Verification" de
  // Didit, confirmado por el equipo que no es dato biométrico, AC6). Nullable: puede
  // no venir en el payload real, no bloquea la aprobación de la verificación en sí.
  expirationDate    DateTime?            @map("expiration_date") @db.Date
  status            DriversLicenseStatus
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycVerification   KycVerification      @relation(fields: [kycVerificationId], references: [id], onDelete: Cascade)

  @@map("drivers_license")
  @@schema("users")
}
