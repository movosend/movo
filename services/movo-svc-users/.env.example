PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/movo
REDIS_URL=redis://localhost:6379
JWT_SECRET=changeme

# MOVO-71: SMS_PROVIDER=console (default) loguea el código de OTP en vez de mandar un
# SMS real — evita costos de Twilio en dev/test/CI (ver ADR-012 en CLAUDE.md). Las
# credenciales de Twilio solo son obligatorias con SMS_PROVIDER=twilio. Auth vía API Key
# (recomendación de Twilio sobre Account SID + Auth Token: alcance limitado, revocable
# sin afectar el resto de la cuenta) — TWILIO_ACCOUNT_SID sigue siendo obligatorio como
# identificador de cuenta, no como credencial.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=

# MOVO-71: TelegramSmsProvider (SMS_PROVIDER=telegram), exclusivo del entorno develop —
# manda el OTP a un grupo de Telegram vía el HTTP API del bot en vez de depender de
# mirar la consola de EC2 en api-dev.movosend.app. Solo obligatorias con
# SMS_PROVIDER=telegram (createSmsProvider falla rápido al arrancar si faltan).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MOVO-72: DIDIT_MODE=mock (default) genera sesiones sintéticas sin red — no depende de
# credenciales de sandbox de Didit.me para levantar el servicio en dev/test/CI, ni
# bloquea el resto de la US si el alta de la cuenta de Didit tarda. DIDIT_MODE=live
# exige las credenciales de abajo (createDiditClient falla rápido al arrancar si
# faltan). Ver README de este servicio para el flujo de webhook local con túnel (ngrok).
# DIDIT_WORKFLOW_ID_IDENTITY / DIDIT_WORKFLOW_ID_LICENSE son dos workflows distintos de
# la consola de Didit (MOVO-72 / MOVO-15 respectivamente).
DIDIT_MODE=mock
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID_IDENTITY=
DIDIT_WORKFLOW_ID_LICENSE=
DIDIT_WEBHOOK_SECRET=

# MOVO-73: GEOCODING_PROVIDER=mock (default) deriva un lat/long determinístico sin red
# — no depende de una API key de Google Maps para levantar el servicio en dev/test/CI.
# GEOCODING_PROVIDER=google exige GOOGLE_MAPS_API_KEY (createGeocodingProvider falla
# rápido al arrancar si falta). Esta key es server-side (Geocoding API, restringida por
# IP) — distinta de la key de renderizado de mapa que usa movo-mobile (restringida por
# bundle id, ver movo-mobile/.env.example).
GEOCODING_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

# MOVO-97: STORAGE_PROVIDER=mock (default) guarda el estado de los objetos en memoria,
# sin red — no depende de un bucket real ni de credenciales de AWS para levantar el
# servicio en dev/test/CI. STORAGE_PROVIDER=s3 exige S3_BUCKET_NAME/S3_REGION
# (createStorageProvider falla rápido al arrancar si faltan). Las credenciales de AWS no
# se cargan acá: en dev-EC2/prod se toman solas del IAM role de la instancia (default
# credential provider chain del SDK), nunca un access key/secret propio (ADR-007/015).
STORAGE_PROVIDER=mock
S3_BUCKET_NAME=
S3_REGION=

# MOVO-106: PUSH_PROVIDER=mock (default) guarda los envíos en memoria, sin red — no
# depende de credenciales para levantar el servicio en dev/test/CI. PUSH_PROVIDER=expo
# usa la API pública de Expo Push (https://exp.host/--/api/v2/push/send), que a
# diferencia de Twilio/Didit/S3 no requiere ninguna credencial propia — Expo
# intermedia la entrega hacia FCM/APNs.
PUSH_PROVIDER=mock
