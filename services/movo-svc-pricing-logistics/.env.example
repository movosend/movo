PORT=8000
REDIS_URL=redis://localhost:6379

# MOVO-138 / ADR-025: coeficientes de demand_fuel_routes_v1 (POST /quote), en LITROS de
# nafta: la tarifa se indexa sola con el precio del surtidor. Todos tienen default en
# app/config.py -- solo hace falta setearlos para recalibrar.
# PRICING_BASE_FARE_L=0.675
# PRICING_FUEL_L_PER_KM=0.08
# PRICING_FUEL_COST_SHARE=0.6  # parte del combustible que paga el emisor (0 a 1)
# PRICING_NON_FUEL_L_PER_KM=0.02
# PRICING_PER_KG_L=0.135
# Recargo por alta demanda (umbral calibrado en el spike MOVO-216, §4.3).
# PRICING_DEMAND_RATIO_THRESHOLD=3.0
# PRICING_DEMAND_MIN_SHIPMENTS=4
# PRICING_DEMAND_BASE_SURCHARGE=0.10
# PRICING_DEMAND_SLOPE=0.05
# PRICING_DEMAND_MAX_SURCHARGE=0.30
# MOVO-82: multiplicador por packageType.
# PRICING_FACTOR_LETTER_DOCUMENT=1.0
# PRICING_FACTOR_STANDARD_PACKAGE=1.0
# PRICING_FACTOR_FRAGILE_ITEM=1.2

# MOVO-138 / ADR-025: precio de la nafta para demand_fuel_routes_v1.
# FUEL_PRICE_PROVIDER=mock  # 'mock' (valor fijo, default en dev/test/CI) o 'energia' (API CKAN de la Secretaría de Energía, cache en Redis)
# PRICING_FUEL_PRICE_FALLBACK_ARS_PER_L=2222.5  # valor del provider mock; con 'energia', último recurso si no hay Redis ni último valor bueno
# PRICING_FUEL_CACHE_TTL_SECONDS=86400  # vida del valor fresco en Redis (el dataset se actualiza una vez por día)

# MOVO-205 / MOVO-217: configuración de routing y proveedor
# ROUTES_PROVIDER=mock  # 'mock' (Haversine, default en dev/test/CI) o 'google' (Routes API real)
# GOOGLE_MAPS_API_KEY=  # Requerida solo si ROUTES_PROVIDER=google
# ROUTING_TIME_LIMIT_SECONDS=1.0
# ROUTING_AVG_SPEED_KMH=40.0
# ROUTING_TIME_SLACK_MINUTES=120
# ROUTING_CACHE_TTL_SECONDS=86400  # 24 horas de TTL con sliding refresh al consultar el feed (MOVO-218)
