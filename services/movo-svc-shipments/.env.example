PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/movo
REDIS_URL=redis://localhost:6379
JWT_SECRET=changeme
# MOVO-80: URL de movo-svc-users para validar al receptor (GET /users/:id). En Docker
# Compose el default de código (http://movo-svc-users:3000) ya alcanza; solo hace falta
# este override para levantar el servicio fuera de Compose (ej. local sin Docker).
# MOVO-108 reusa la misma var para notifications-client.ts (POST /internal/notifications/push,
# también en movo-svc-users) -- no hace falta una URL separada, ambos endpoints viven
# en el mismo servicio.
USERS_SERVICE_URL=http://localhost:3001

# MOVO-116: URL de movo-svc-payments para el bloqueo del transportista sin cuenta de
# Mercado Pago vinculada (GET /internal/payments/mp-connect/:userId/status). Mismo
# criterio que USERS_SERVICE_URL: en Docker Compose alcanza el default de código
# (http://movo-svc-payments:3000), este override es para levantar fuera de Compose.
PAYMENTS_SERVICE_URL=http://localhost:3003

# MOVO-82: URL de movo-svc-pricing-logistics para el precio sugerido (POST /quote). En
# Docker Compose el default de código (http://movo-svc-pricing-logistics:8000) ya
# alcanza; solo hace falta este override para levantar el servicio fuera de Compose.
PRICING_SERVICE_URL=http://localhost:3005

# MOVO-81: STORAGE_PROVIDER=mock (default) guarda el estado de los objetos en memoria,
# sin red — no depende de un bucket real ni de credenciales de AWS para levantar el
# servicio en dev/test/CI. STORAGE_PROVIDER=s3 exige S3_BUCKET_NAME/S3_REGION
# (createStorageProvider falla rápido al arrancar si faltan). Comparte el mismo bucket
# que movo-svc-users (movo-shipment-media-{env}), prefijo shipments/* en vez de
# profile-photos/*. Las credenciales de AWS no se cargan acá: en dev-EC2/prod se toman
# solas del IAM role de la instancia (ADR-007/015).
STORAGE_PROVIDER=mock
S3_BUCKET_NAME=
S3_REGION=

# MOVO-123: ruta real por calle del mapa del wizard de envíos (Google Routes API,
# método Compute Routes). "mock" (default) interpola una línea recta sin red — no
# requiere GOOGLE_MAPS_API_KEY. Misma API key server-side que GEOCODING_PROVIDER=google
# en movo-svc-users (ADR-014), pendiente de carga real en Secrets Manager.
ROUTES_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

# MOVO-130: Expiración automática del envío no confirmado por el receptor.
# Plazo en horas para que el receptor acepte o rechace antes de que el envío expire (default 48).
RECEIVER_CONFIRMATION_TIMEOUT_HOURS=48
# Intervalo en minutos del barrido periódico para cancelar envíos vencidos (default 15).
RECEIVER_CONFIRMATION_SWEEP_INTERVAL_MINUTES=15
# Habilita/deshabilita el barrido periódico (default true). Poner en false en test/CI para
# evitar timers de background durante los tests.
RECEIVER_CONFIRMATION_SWEEP_ENABLED=true
# MOVO-253: plazo en horas para que el emisor elija otro receptor tras un rechazo
# (default 48, con tope en la ventana de retiro). Lo cierra el mismo barrido de arriba.
RECEIVER_REDESIGNATION_TIMEOUT_HOURS=48
# MOVO-275: plazo en horas para que la persona invitada acepte recibir el paquete en una
# transferencia de receptor (default 6). La vence el mismo barrido de arriba; además se
# cancela si empieza el handshake de entrega.
RECEIVER_TRANSFER_TIMEOUT_HOURS=6

# MOVO-124: sweep de objetos huérfanos en S3 (fotos presignadas nunca confirmadas).
# Ventana en horas desde el presign antes de considerar huérfana una key (default 24).
ORPHAN_PHOTO_RETENTION_HOURS=24
# Intervalo en minutos del barrido periódico de fotos huérfanas (default 60).
ORPHAN_PHOTO_SWEEP_INTERVAL_MINUTES=60
# Habilita/deshabilita el barrido (default true). Poner en false en test/CI para evitar
# timers de background durante los tests.
ORPHAN_PHOTO_SWEEP_ENABLED=true

# MOVO-147: score de reputación ponderado (domain/reputation.ts). Constante de
# confianza `C` del shrinkage bayesiano hacia la media global de la plataforma --
# mientras más alta, más calificaciones hacen falta para alejarse de esa media
# (default 5).
REPUTATION_CONFIDENCE_CONSTANT=5
# Semivida en días del decaimiento temporal de cada calificación -- cada una pesa
# 0.5^(antigüedad_en_días/semivida) (default 180).
REPUTATION_DECAY_HALF_LIFE_DAYS=180

# MOVO-161: radio máximo de desvío ortogonal al corredor del viaje declarado
# para matching geométrico de paquetes compatibles (default 15 km, spike MOVO-50 CA6).
TRIP_DEFAULT_MAX_DETOUR_KM=15

# MOVO-143: comisión de Movo + fee de MercadoPago, leídas directo de process.env por
# @movo/shared (shared/movo-shared/src/config/commission.ts), mismo patrón que
# JWT_SECRET/JWT_ISSUER en auth/config.ts -- no pasan por el envSchema de este
# servicio (no viajan en app.config). Confirmado con el equipo: comisión de Movo 15%.
MOVO_COMMISSION_RATE=0.15
# ESTIMADO de la comisión de MercadoPago (default de `getCommissionConfig()`). Hoy
# ningún cálculo del backend la usa: lo que ve el transportista en la app sale de
# `EXPO_PUBLIC_MP_TRANSACTION_FEE_RATE` de movo-mobile, así que cambiar esta var no
# cambia nada de lo que muestra la app. No es un valor contractual (MOVO-225): MP la
# cobra sobre la cuenta del transportista y varía según sus tarifas y el plazo de
# liberación del dinero que cada uno configura. A validar con pagos reales (el 4,1% del
# sandbox es la única observación). El monto real de cada pago lo informa MP.
MP_TRANSACTION_FEE_RATE=0.0499

# Corrección directa sobre un bug reportado (sin ticket propio): barrido que cancela
# envíos `published` cuya ventana de retiro venció sin que ningún transportista lo
# tomara -- GET /shipments/available los seguía devolviendo como disponibles.
# Intervalo en minutos del barrido periódico (default 15, mismo criterio que MOVO-130).
PICKUP_EXPIRY_SWEEP_INTERVAL_MINUTES=15
# Habilita/deshabilita el barrido (default true). Poner en false en test/CI para evitar
# timers de background durante los tests.
PICKUP_EXPIRY_SWEEP_ENABLED=true

# MOVO-158 (AC7, ADR-012/016 mold) + MOVO-212: liberación de fondos al confirmar la entrega.
# "console" (default, no-op/log) en dev/test/CI; "payments" captura el hold real.
FUNDS_RELEASE_NOTIFIER=console
# MOVO-212: con FUNDS_RELEASE_NOTIFIER=payments, la entrega captura el hold en movo-svc-payments
# y pasa el envío a `completed`. Este barrido reintenta los `delivered` que quedaron sin cobrar
# (solo corre con `payments`); el backoff y el escalado manual viven en svc-payments (MOVO-213).
SETTLEMENT_SWEEP_INTERVAL_MINUTES=5
SETTLEMENT_SWEEP_GRACE_MINUTES=5
SETTLEMENT_SWEEP_BATCH_SIZE=20
# Poner en false en test/CI para evitar timers de background durante los tests.
SETTLEMENT_SWEEP_ENABLED=true
# MOVO-213: plazo que se le promete al transportista cuando su cobro queda en revisión manual.
SETTLEMENT_REVIEW_SLA_HOURS=48

# MOVO-202/DD-023: retención de la traza GPS del transportista (evidencia para
# disputas, MOVO-30 -- no analítica). Días desde que el envío cierra hasta que la
# purga periódica la borra automáticamente.
CARRIER_POSITION_RETENTION_DAYS=30
# Intervalo en minutos del barrido de purga (default 60 -- menos urgente que los
# sweeps operativos, un rezago de hasta 1h sobre un plazo de 30 días no importa).
CARRIER_POSITION_PURGE_SWEEP_INTERVAL_MINUTES=60
CARRIER_POSITION_PURGE_SWEEP_ENABLED=true
# MOVO-327: segundos sin un ping del transportista para que el seguimiento del panel marque
# "sin señal" (`signalLost`). La cadencia de envío del mobile ronda los 45 s.
TRACKING_SIGNAL_LOST_SECONDS=300

# MOVO-230 (Política de Privacidad §7): purga del historial de envíos y viajes cuyas partes se
# dieron de baja hace más de SHIPMENT_HISTORY_RETENTION_YEARS años (default 5, contado desde la
# baja más reciente). Consulta las fechas de baja a svc-users (USERS_SERVICE_URL) y borra las
# fotos de S3. Intervalo en minutos (default 1440, una vez por día). ENABLED en false en
# test/CI para evitar timers.
SHIPMENT_HISTORY_RETENTION_YEARS=5
SHIPMENT_HISTORY_PURGE_SWEEP_INTERVAL_MINUTES=1440
SHIPMENT_HISTORY_PURGE_SWEEP_ENABLED=true

# MOVO-238: barrido que cancela automáticamente los viajes `declared` cuyo departureAt ya
# pasó sin que el transportista los iniciara ni tuvieran un paquete aceptado.
# Intervalo en minutos (default 15, mismo criterio que PICKUP_EXPIRY_SWEEP_*).
TRIP_EXPIRY_SWEEP_INTERVAL_MINUTES=15
# Poner en false en test/CI para evitar timers de background durante los tests.
TRIP_EXPIRY_SWEEP_ENABLED=true

# MOVO-258 (D1): barrido que cancela envíos con transportista asignado (assignment_pending/
# assigned_unfunded/assigned) cuya ventana de retiro cerró hace más del margen de gracia.
# Intervalo en minutos (default 15, mismo criterio que PICKUP_EXPIRY_SWEEP_*).
PICKUP_MISSED_SWEEP_INTERVAL_MINUTES=15
# Poner en false en test/CI para evitar timers de background durante los tests.
PICKUP_MISSED_SWEEP_ENABLED=true
# Horas de gracia después de cerrar la ventana de retiro antes de cancelar (default 24), por
# si el retiro se hizo tarde y el handshake llega después.
PICKUP_MISSED_GRACE_HOURS=24
# MOVO-270 (DD-052, AC12): la push al emisor de un no-retiro atribuido al transportista lo invita a
# calificarlo. Prendido desde MOVO-337, que habilitó calificar envíos no entregados.
PICKUP_NO_SHOW_RATING_INVITE_ENABLED=true

# MOVO-258 (D4): barrido que MARCA para revisión (nunca cancela) los envíos in_transit que no
# se entregaron pasada su entrega estimada + 50% de la duración estimada.
TRANSIT_ANOMALY_SWEEP_INTERVAL_MINUTES=15
TRANSIT_ANOMALY_SWEEP_ENABLED=true
# Plazo fijo (horas desde el retiro) para un in_transit cuya oferta no declaró entrega
# estimada (es opcional en la oferta). Default 48.
IN_TRANSIT_ANOMALY_FALLBACK_HOURS=48
# MOVO-278 (DD-045): horas desde que el envío se marca como demorado hasta el aviso previo
# al transportista y hasta pasarlo a disputa. WARN tiene que ser menor que DISPUTE.
IN_TRANSIT_ANOMALY_WARN_AFTER_HOURS=12
IN_TRANSIT_ANOMALY_DISPUTE_AFTER_HOURS=24

# MOVO-240: recordatorio al transportista el día anterior a su viaje declarado (sale desde
# las 19:00, hora argentina, una sola vez por viaje).
TRIP_DEPARTURE_REMINDER_SWEEP_INTERVAL_MINUTES=15
TRIP_DEPARTURE_REMINDER_SWEEP_ENABLED=true


# MOVO-210: saga de asignación (pago del emisor al aceptar o ventana de confirmación).
# (PAYMENTS_SERVICE_URL, la URL interna de movo-svc-payments, ya está más arriba: MOVO-116.)
# "N" de la saga: un retiro a N días o menos (inclusive) toma la ruta cercana (el emisor
# paga al aceptar, assignment_pending); a más de N, la ruta lejana (assigned_unfunded +
# ventana de confirmación). N + tránsito máximo <= plazo del hold de MP
# (MP_HOLD_VALIDITY_DAYS de svc-payments): 3 + 2 <= 5, DD-050.
FUNDING_NEAR_PICKUP_DAYS=3
# Plazo (minutos) del emisor para completar el pago en la ruta cercana, desde que acepta.
FUNDING_PAYMENT_TIMEOUT_MINUTES=30
# La ruta lejana vuelve a `published` si no hay pago a estas horas del inicio del retiro (T-24h).
FUNDING_RELEASE_HOURS_BEFORE_PICKUP=24
# Cada cuántas horas se recuerda "Confirmá el pago" con la ventana abierta.
FUNDING_REMINDER_INTERVAL_HOURS=12
# Barrido de la saga: timeout del pago, apertura/recordatorios/cierre de la ventana.
FUNDING_SWEEP_INTERVAL_MINUTES=5
# Poner en false en test/CI para evitar timers de background durante los tests.
FUNDING_SWEEP_ENABLED=true

# MOVO-313 (DD-044): días de antigüedad a partir de los cuales una deuda sin saldar de la
# cuenta corriente (svc-payments) bloquea operar como transportista: declarar viaje, ofertar,
# editar oferta e iniciar viaje. Se compara con ">" (a los 14 días justos todavía no). Sin
# monto mínimo. Como emisor no se bloquea. Default 14.
USER_DEBT_OVERDUE_DAYS=14

# MOVO-334: alerta al equipo cuando una parte abre una disputa. Mismas vars que svc-payments
# (MOVO-268). `console` solo loguea; `telegram` además manda al chat del equipo.
ALERT_PROVIDER=console
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Prefijo de cada alerta para distinguir ambientes en el mismo chat (`dev`, `prod`).
ALERT_ENVIRONMENT_LABEL=
