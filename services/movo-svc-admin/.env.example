PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/movo
REDIS_URL=redis://localhost:6379
# MOVO-288: servicios dueños a los que svc-admin llama por endpoints internos.
# Defaults del envSchema: el nombre del servicio en movo-net (Docker Compose).
USERS_SERVICE_URL=http://localhost:3001
SHIPMENTS_SERVICE_URL=http://localhost:3002
PAYMENTS_SERVICE_URL=http://localhost:3003
# MOVO-322: WebSocket de la bandeja de soporte. URL pública (la del gateway) que va en el ticket, y orígenes del
# panel que lo pueden abrir (separados por coma; `*` es comodín de un tramo, para los previews de Vercel).
# Dev:  SUPPORT_WS_PUBLIC_URL=wss://api-dev.movosend.app/api/v1/admin/support/ws
#       SUPPORT_WS_ALLOWED_ORIGINS=https://movo-admin-git-*-movoteamprojects.vercel.app
# Prod: SUPPORT_WS_PUBLIC_URL=wss://api.movosend.app/api/v1/admin/support/ws
#       SUPPORT_WS_ALLOWED_ORIGINS=https://admin.movosend.app
SUPPORT_WS_PUBLIC_URL=wss://localhost/api/v1/admin/support/ws
SUPPORT_WS_ALLOWED_ORIGINS=https://localhost:3000
